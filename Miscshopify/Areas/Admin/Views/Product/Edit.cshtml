@using Miscshopify.Core.Models;
@model ProductViewModel
@{
    ViewData["Title"] = "Edit Product";
}

<link href="~/css/admin/product-edit.css" rel="stylesheet" />

<div class="product-edit-section">
    <section class="product-edit-section">
        <div class="product-edit-card">
            <div class="card-content">
                <div class="card-body">
                    <ul class="nav-tabs" role="tablist">
                        <li class="nav-item">
                            <a class="nav-link active" id="account-tab" data-toggle="tab" href="#account" aria-controls="account" role="tab" aria-selected="true">
                                <i class="fas fa-edit"></i>
                                <span>Edit Product</span>
                            </a>
                        </li>
                    </ul>
                    <div class="tab-content">
                        <div class="tab-pane active" id="account" aria-labelledby="account-tab" role="tabpanel">
                            <form id="edit" method="post" enctype="multipart/form-data">
                                <div class="row">
                                    <div class="col-12 col-md-8 col-lg-6">
                                        <input type="hidden" name="Id" value="@Model.Id" />
                                        <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                                        <!-- Product Stats (if available) -->
                                        <div class="product-stats">
                                            <div class="stat-item">
                                                <div class="stat-value">@(Model.Price.ToString("C") ?? "N/A")</div>
                                                <div class="stat-label">Current Price</div>
                                            </div>
                                            <!-- Add more stats if available in your model -->
                                        </div>

                                        <div class="form-group">
                                            <label asp-for="Name" class="form-label">Product Name *</label>
                                            <input asp-for="Name" class="form-control" aria-required="true"
                                                   placeholder="Enter product name" />
                                            <span asp-validation-for="Name" class="text-danger"></span>
                                        </div>

                                        <div class="form-group">
                                            <label asp-for="Description" class="form-label">Description *</label>
                                            <textarea asp-for="Description" class="form-control" aria-required="true"
                                                      rows="4" placeholder="Enter product description"
                                                      maxlength="500">@Model.Description</textarea>
                                            <div class="char-counter" id="descriptionCounter">@(Model.Description?.Length ?? 0)/500 characters</div>
                                            <span asp-validation-for="Description" class="text-danger"></span>
                                        </div>

                                        <div class="form-group">
                                            <label asp-for="Price" class="form-label">Price *</label>
                                            <div class="price-input-container">
                                                <span class="price-prefix">$</span>
                                                <input asp-for="Price" class="form-control price-input"
                                                       aria-required="true" type="number" step="0.01" min="0"
                                                       placeholder="0.00" value="@Model.Price" />
                                            </div>
                                            <span asp-validation-for="Price" class="text-danger"></span>
                                        </div>

                                        <!-- Current Image Display -->
                                        @if (!string.IsNullOrEmpty(Model.ImagePath))
                                        {
                                            <div class="form-group">
                                                <label class="form-label">Current Image</label>
                                                <div class="current-image-container">
                                                    <img src="~/@Model.ImagePath" class="current-image"
                                                         alt="Current product image"
                                                         onerror="this.src='https://via.placeholder.com/200?text=📷'" />
                                                </div>
                                            </div>
                                        }

                                        <!-- Image Upload for Replacement -->
                                        <div class="form-group">
                                            <div class="file-upload-container">
                                                <label class="file-upload-label">Update Product Image</label>
                                                <div class="file-upload-wrapper">
                                                    <input type="file" name="file" id="fileInput" class="file-upload-input"
                                                           accept="image/*" />
                                                    <label for="fileInput" class="file-upload-button" id="fileUploadButton">
                                                        <i class="fas fa-cloud-upload-alt"></i>
                                                        <span>Choose New Image</span>
                                                    </label>
                                                </div>
                                                <div class="file-name" id="fileName" style="display: none;">
                                                    <i class="fas fa-check-circle"></i>
                                                    <span></span>
                                                </div>
                                                <span asp-validation-for="ImagePath" class="text-danger"></span>
                                            </div>

                                            <!-- Image Preview -->
                                            <div class="image-preview-container">
                                                <img id="imagePreview" class="image-preview"
                                                     alt="New product image preview" />
                                            </div>
                                        </div>

                                        <!-- Additional Product Fields (if needed) -->
                                        <div class="form-group">
                                            <label class="form-label">Stock Quantity</label>
                                            <input type="number" class="form-control" name="StockQuantity"
                                                   min="0" value="0" placeholder="Enter stock quantity" />
                                        </div>

                                        <!-- Divider -->
                                        <hr class="divider">

                                        <!-- Delete Section -->
                                        <div class="delete-section">
                                            <h5>
                                                <i class="fas fa-exclamation-triangle"></i>
                                                Danger Zone
                                            </h5>
                                            <p class="text-sm text-gray-600 mb-3">
                                                Once you delete this product, it will be permanently removed from the system. This action cannot be undone.
                                            </p>
                                            <a asp-area="Admin" asp-action="RemoveProduct" asp-controller="Product"
                                               asp-route-id="@Model.Id" class="btn btn-danger"
                                               onclick="return confirmDelete('@Model.Name')">
                                                <i class="fas fa-trash"></i>
                                                Delete Product
                                            </a>
                                            <div class="delete-warning">
                                                <i class="fas fa-radiation"></i>
                                                This action is irreversible
                                            </div>
                                        </div>
                                    </div>

                                    <div class="col-12">
                                        <div class="form-actions">
                                            <button type="submit" class="btn btn-primary" id="submitButton">
                                                <i class="fas fa-save"></i>
                                                Save Changes
                                            </button>
                                            <a href="/Admin/Product/Index" class="btn btn-light">
                                                <i class="fas fa-times"></i>
                                                Cancel
                                            </a>
                                        </div>
                                    </div>
                                </div>
                            </form>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        // Enhanced delete confirmation
        function confirmDelete(productName) {
            return confirm(`⚠️ WARNING: You are about to delete "${productName}". This action cannot be undone. Are you sure?`);
        }

        // File upload handling
        document.getElementById('fileInput').addEventListener('change', function(e) {
            const file = e.target.files[0];
            const fileNameElement = document.getElementById('fileName');
            const fileUploadButton = document.getElementById('fileUploadButton');
            const imagePreview = document.getElementById('imagePreview');

            if (file) {
                // Show file name
                fileNameElement.style.display = 'flex';
                fileNameElement.querySelector('span').textContent = file.name;

                // Update button style
                fileUploadButton.classList.add('has-file');
                fileUploadButton.innerHTML = '<i class="fas fa-check"></i><span>Change Image</span>';

                // Show image preview
                const reader = new FileReader();
                reader.onload = function(e) {
                    imagePreview.src = e.target.result;
                    imagePreview.classList.add('visible');
                }
                reader.readAsDataURL(file);
            } else {
                // Reset file upload
                fileNameElement.style.display = 'none';
                fileUploadButton.classList.remove('has-file');
                fileUploadButton.innerHTML = '<i class="fas fa-cloud-upload-alt"></i><span>Choose New Image</span>';
                imagePreview.classList.remove('visible');
            }
        });

        // Description character counter
        const descriptionTextarea = document.querySelector('textarea[name="Description"]');
        const charCounter = document.getElementById('descriptionCounter');

        descriptionTextarea.addEventListener('input', function() {
            const length = this.value.length;
            charCounter.textContent = `${length}/500 characters`;

            if (length > 450) {
                charCounter.classList.add('warning');
                charCounter.classList.remove('error');
            } else if (length > 490) {
                charCounter.classList.remove('warning');
                charCounter.classList.add('error');
            } else {
                charCounter.classList.remove('warning', 'error');
            }
        });

        // Form submission enhancement
        document.getElementById('edit').addEventListener('submit', function(e) {
            const submitButton = document.getElementById('submitButton');
            const originalText = submitButton.innerHTML;

            // Show loading state
            submitButton.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Saving Changes...';
            submitButton.disabled = true;

            // Validate price
            const priceInput = document.querySelector('input[name="Price"]');
            if (!priceInput.value || parseFloat(priceInput.value) <= 0) {
                e.preventDefault();
                alert('Please enter a valid price greater than 0.');
                submitButton.innerHTML = originalText;
                submitButton.disabled = false;
                priceInput.focus();
                return;
            }

            // Allow form to submit normally
            console.log('Form submitted successfully');
        });

        // Price input formatting
        document.querySelector('input[name="Price"]').addEventListener('blur', function() {
            if (this.value) {
                const value = parseFloat(this.value).toFixed(2);
                this.value = value;
            }
        });

        // Add input validation styling
        document.querySelectorAll('.form-control').forEach(input => {
            input.addEventListener('blur', function() {
                if (this.value.trim() !== '') {
                    this.classList.add('filled');
                } else {
                    this.classList.remove('filled');
                }
            });

            input.addEventListener('input', function() {
                if (this.checkValidity()) {
                    this.classList.remove('input-validation-error');
                }
            });
        });

        // Initialize character counter on page load
        document.addEventListener('DOMContentLoaded', function() {
            const initialLength = descriptionTextarea.value.length;
            charCounter.textContent = `${initialLength}/500 characters`;

            if (initialLength > 450) {
                charCounter.classList.add('warning');
            }
            if (initialLength > 490) {
                charCounter.classList.add('error');
            }
        });

        // Enhanced delete button with double confirmation
        document.querySelector('.btn-danger').addEventListener('click', function(e) {
            const productName = document.querySelector('input[name="Name"]').value || 'this product';
            const confirmed = confirm(`🚨 FINAL WARNING!\n\nYou are about to permanently delete "${productName}".\n\nThis will remove:\n• The product itself\n• All associated data\n• Product images\n\nTHIS ACTION CANNOT BE UNDONE!\n\nType "DELETE" to confirm:`);

            if (confirmed) {
                const userInput = prompt('Please type "DELETE" to confirm permanent deletion:');
                if (userInput !== 'DELETE') {
                    e.preventDefault();
                    alert('Deletion cancelled. Product was NOT deleted.');
                }
            } else {
                e.preventDefault();
            }
        });
    </script>
}