@using Miscshopify.Infrastructure.Data.Models.Enums
@using Microsoft.EntityFrameworkCore
@inject Miscshopify.Infrastructure.Data.MiscshopifyContext _context

@{
    var totalUsers = await _context.Users.CountAsync();
    var totalCategories = await _context.Categories.CountAsync();
    var totalProducts = await _context.Products.CountAsync();
    var newOrders = await _context.Orders.CountAsync(o => o.Status == OrderStatusEnum.Pending);
    var ordersOnTheWay = await _context.Orders.CountAsync(o => o.Status == OrderStatusEnum.OnTheWay);
    var completed = await _context.Orders.CountAsync(o => o.Status == OrderStatusEnum.Completed);
    var allOrders = await _context.Orders.CountAsync();
}

<!-- Sidebar Menu -->
<nav class="sidebar-nav p-4 space-y-2">
    <!-- Dashboard -->
    <a href="/Admin" class="sidebar-nav-item group">
        <i class="fas fa-chart-line text-blue-400"></i>
        <span class="nav-text">Dashboard</span>
    </a>

    <!-- Users -->
    <a href="/Admin/User/Index" class="sidebar-nav-item group">
        <i class="fas fa-users text-green-400"></i>
        <span class="nav-text">Users</span>
        <span class="sidebar-badge">@totalUsers</span>
    </a>

    <!-- Categories -->
    <a href="/Admin/Category/Index" class="sidebar-nav-item group">
        <i class="fas fa-list text-purple-400"></i>
        <span class="nav-text">Categories</span>
        <span class="sidebar-badge">@totalCategories</span>
    </a>

    <!-- Products -->
    <a href="/Admin/Product/Index" class="sidebar-nav-item group">
        <i class="fas fa-basket-shopping text-yellow-400"></i>
        <span class="nav-text">Products</span>
        <span class="sidebar-badge">@totalProducts</span>
    </a>

    <!-- Orders Dropdown - Винаги отворен по подразбиране -->
    <div class="sidebar-dropdown">
        <button class="sidebar-nav-item group w-full text-left">
            <i class="fas fa-truck-fast text-orange-400"></i>
            <span class="nav-text">Orders</span>
            <i class="fas fa-chevron-down ml-auto transition-transform duration-200 dropdown-arrow rotate-180"></i>
        </button>
        <div class="sidebar-dropdown-content show">
            <a href="/Admin/Order/NewOrders" class="sidebar-dropdown-item">
                <i class="fas fa-clock text-blue-400"></i>
                <span class="nav-text">New Orders</span>
                <span class="sidebar-badge bg-blue-500">@newOrders</span>
            </a>
            <a href="/Admin/Order/OrdersOnTheWay" class="sidebar-dropdown-item">
                <i class="fas fa-shipping-fast text-green-400"></i>
                <span class="nav-text">On the Way</span>
                <span class="sidebar-badge bg-green-500">@ordersOnTheWay</span>
            </a>
            <a href="/Admin/Order/Completed" class="sidebar-dropdown-item">
                <i class="fas fa-check-circle text-teal-400"></i>
                <span class="nav-text">Completed</span>
                <span class="sidebar-badge bg-teal-500">@completed</span>
            </a>
            <a href="/Admin/Order/Index" class="sidebar-dropdown-item">
                <i class="fas fa-border-all text-gray-400"></i>
                <span class="nav-text">All Orders</span>
                <span class="sidebar-badge">@allOrders</span>
            </a>
        </div>
    </div>

    <!-- Settings -->
    <a href="/Admin/Settings" class="sidebar-nav-item group">
        <i class="fas fa-cog text-gray-400"></i>
        <span class="nav-text">Settings</span>
    </a>
</nav>