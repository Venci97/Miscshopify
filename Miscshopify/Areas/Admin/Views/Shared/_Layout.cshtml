<!DOCTYPE html>
<html lang="en">
<head>
    <title>Miscshopify - Admin</title>
    <link rel="icon" href="~/img/Miscshopify_Logo" type="image/x-icon">
    <link rel="apple-touch-icon" sizes="57x57" href="~/img/apple-icon-57x57.png">
    <link rel="apple-touch-icon" sizes="60x60" href="~/img/apple-icon-60x60.png">
    <link rel="apple-touch-icon" sizes="72x72" href="~/img/apple-icon-72x72.png">
    <link rel="apple-touch-icon" sizes="76x76" href="~/img/apple-icon-76x76.png">
    <link rel="apple-touch-icon" sizes="114x114" href="~/img/apple-icon-114x114.png">
    <link rel="apple-touch-icon" sizes="120x120" href="~/img/apple-icon-120x120.png">
    <link rel="apple-touch-icon" sizes="144x144" href="~/img/apple-icon-144x144.png">
    <link rel="apple-touch-icon" sizes="152x152" href="~/img/apple-icon-152x152.png">
    <link rel="apple-touch-icon" sizes="180x180" href="~/img/apple-icon-180x180.png">
    <link rel="icon" type="image/png" sizes="192x192" href="~/img/android-icon-192x192.png">
    <link rel="icon" type="image/png" sizes="32x32" href="~/img/favicon-32x32.png">
    <link rel="icon" type="image/png" sizes="96x96" href="~/img/favicon-96x96.png">
    <link rel="icon" type="image/png" sizes="16x16" href="~/img/favicon-16x16.png">
    <link rel="manifest" href="/manifest.json">

    <!-- Modern CSS Framework -->
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    <link href="~/css/admin/admin-modern.css" rel="stylesheet" />
</head>
<body class="admin-modern-layout bg-gray-50" style="font-family: 'Inter', sans-serif;">
    <div class="flex h-screen">
        <!-- Sidebar -->
        <div class="admin-sidebar w-64 bg-gradient-to-b from-gray-900 to-gray-800 text-white transform transition-all duration-300 ease-in-out">
            <!-- Brand Logo -->
            <div class="sidebar-header p-6 border-b border-gray-700 relative">
                <div class="flex items-center space-x-3">
                    <img src="~/img/Miscshopify_Logo_No_Traansperant.png" alt="Miscshopify Logo" class="w-10 h-10 rounded-lg shadow-lg">
                    <div class="brand-text">
                        <h1 class="text-xl font-bold text-white">Miscshopify</h1>
                        <p class="text-xs text-gray-400">Admin Panel</p>
                    </div>
                </div>

                <!-- Toggle Sidebar Button -->
                <button id="sidebarToggleCollapse" class="sidebar-collapse-btn absolute -right-3 top-1/2 transform -translate-y-1/2 bg-gray-800 hover:bg-gray-700 text-gray-300 hover:text-white rounded-full p-1 w-6 h-6 flex items-center justify-center text-xs transition-all duration-300 shadow-lg border border-gray-600">
                    <i class="fas fa-chevron-left"></i>
                </button>
            </div>

            <!-- Sidebar Menu - Използваме View Component -->
            @await Component.InvokeAsync("Sidebar")

            <!-- Sidebar Footer -->
            <div class="sidebar-footer p-4 border-t border-gray-700 mt-auto">
                <div class="text-center">
                    <p class="text-xs text-gray-400 footer-text">Miscshopify v2.0</p>
                    <p class="text-xs text-gray-500 footer-text">Admin Panel</p>
                </div>
            </div>
        </div>

        <!-- Main Content -->
        <div class="flex-1 flex flex-col overflow-hidden">
            <!-- Top Navigation -->
            <header class="admin-header bg-white shadow-sm border-b border-gray-200">
                <div class="flex items-center justify-between px-6 py-4">
                    <!-- Left Section -->
                    <div class="flex items-center space-x-4">
                        <!-- Mobile Menu Button -->
                        <button id="sidebarToggle" class="lg:hidden text-gray-600 hover:text-gray-900">
                            <i class="fas fa-bars text-xl"></i>
                        </button>

                        <!-- Breadcrumb -->
                        <div class="hidden md:flex items-center space-x-2 text-sm text-gray-600">
                            <a href="/Home" class="hover:text-blue-600 transition-colors">Home</a>
                            <i class="fas fa-chevron-right text-xs"></i>
                            <a href="/Admin" class="hover:text-blue-600 transition-colors">Admin</a>
                            <i class="fas fa-chevron-right text-xs"></i>
                            <span class="text-gray-900 font-medium">@ViewData["Title"]</span>
                        </div>
                    </div>

                    <!-- Right Section -->
                    <div class="flex items-center space-x-4">
                        <!-- Search -->
                        <div class="relative hidden md:block">
                            <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
                                <i class="fas fa-search text-gray-400"></i>
                            </div>
                            <input type="text"
                                   class="admin-search-input pl-10 pr-4 py-2 rounded-lg border border-gray-300 focus:ring-2 focus:ring-blue-500 focus:border-blue-500 transition-all duration-200"
                                   placeholder="Search...">
                        </div>

                        <!-- Notifications -->
                        <div class="relative">
                            <button class="admin-header-btn relative">
                                <i class="fas fa-bell"></i>
                                <span class="admin-notification-badge">3</span>
                            </button>
                        </div>

                        <!-- User Menu -->
                        <div class="relative" id="userMenu">
                            <button class="admin-user-btn flex items-center space-x-2" id="userMenuButton">
                                <div class="w-8 h-8 bg-gradient-to-r from-blue-500 to-purple-600 rounded-full flex items-center justify-center text-white text-sm font-semibold">
                                    A
                                </div>
                                <span class="hidden md:block text-sm font-medium text-gray-700">Admin</span>
                                <i class="fas fa-chevron-down text-xs text-gray-500 transition-transform duration-200"></i>
                            </button>

                            <!-- Dropdown Menu -->
                            <div class="user-dropdown-menu absolute right-0 mt-2 w-48 bg-white rounded-lg shadow-xl border border-gray-200 py-1 z-50 opacity-0 invisible transform -translate-y-2 transition-all duration-200">
                                <a href="/Profile" class="block px-4 py-2 text-sm text-gray-700 hover:bg-gray-100 transition-colors">
                                    <i class="fas fa-user-circle mr-2 text-gray-400"></i>
                                    Profile
                                </a>
                                <a href="/Settings" class="block px-4 py-2 text-sm text-gray-700 hover:bg-gray-100 transition-colors">
                                    <i class="fas fa-cog mr-2 text-gray-400"></i>
                                    Settings
                                </a>
                                <div class="border-t border-gray-200 my-1"></div>
                                <form asp-area="Identity" asp-page="/Account/Logout" method="post" class="block">
                                    <button type="submit" class="w-full text-left px-4 py-2 text-sm text-gray-700 hover:bg-gray-100 transition-colors">
                                        <i class="fas fa-sign-out-alt mr-2 text-gray-400"></i>
                                        Logout
                                    </button>
                                </form>
                            </div>
                        </div>
                    </div>
                </div>
            </header>

            <!-- Page Content -->
            <main class="flex-1 overflow-y-auto bg-gray-50">
                <!-- Page Header -->
                <div class="page-header bg-white shadow-sm">
                    <div class="px-6 py-4">
                        <h1 class="text-2xl font-bold text-gray-900">@ViewData["Title"]</h1>
                        <p class="text-gray-600 mt-1">Manage your store efficiently</p>
                    </div>
                </div>

                <!-- Main Content Area -->
                <div class="p-6">
                    @RenderBody()
                </div>
            </main>
        </div>
    </div>

    <!-- Scripts -->
    <script src="~/plugins/jquery/jquery.min.js"></script>
    <script>
        // Mobile sidebar toggle
        document.getElementById('sidebarToggle').addEventListener('click', function() {
            document.querySelector('.admin-sidebar').classList.toggle('mobile-open');
        });

        // Sidebar collapse toggle
        const sidebarCollapseBtn = document.getElementById('sidebarToggleCollapse');
        const adminSidebar = document.querySelector('.admin-sidebar');

        if (sidebarCollapseBtn && adminSidebar) {
            sidebarCollapseBtn.addEventListener('click', function() {
                adminSidebar.classList.toggle('collapsed');

                // Save state to localStorage
                const isCollapsed = adminSidebar.classList.contains('collapsed');
                localStorage.setItem('sidebarCollapsed', isCollapsed);
            });

            // Load saved state from localStorage
            const isCollapsed = localStorage.getItem('sidebarCollapsed') === 'true';
            if (isCollapsed) {
                adminSidebar.classList.add('collapsed');
            }
        }

        // Orders Dropdown - специална логика
        function initializeOrdersDropdown() {
            const ordersDropdown = document.querySelector('.sidebar-dropdown');
            const ordersDropdownContent = ordersDropdown?.querySelector('.sidebar-dropdown-content');
            const ordersDropdownArrow = ordersDropdown?.querySelector('.dropdown-arrow');

            if (!ordersDropdown || !ordersDropdownContent || !ordersDropdownArrow) return;

            // Зареди състоянието от localStorage
            const ordersDropdownState = localStorage.getItem('ordersDropdownState');

            // Ако няма записано състояние, задай "open" по подразбиране
            if (ordersDropdownState === null) {
                localStorage.setItem('ordersDropdownState', 'open');
            }

            // Приложи състоянието
            if (ordersDropdownState === 'closed') {
                ordersDropdownContent.classList.remove('show');
                ordersDropdownArrow.classList.remove('rotate-180');
            } else {
                ordersDropdownContent.classList.add('show');
                ordersDropdownArrow.classList.add('rotate-180');
            }

            // Слушател за клик върху Orders dropdown бутона
            ordersDropdown.querySelector('button').addEventListener('click', function(e) {
                // Only toggle if sidebar is not collapsed
                if (!adminSidebar.classList.contains('collapsed')) {
                    e.stopPropagation();
                    e.preventDefault();

                    const isOpen = ordersDropdownContent.classList.contains('show');

                    if (isOpen) {
                        ordersDropdownContent.classList.remove('show');
                        ordersDropdownArrow.classList.remove('rotate-180');
                        localStorage.setItem('ordersDropdownState', 'closed');
                    } else {
                        ordersDropdownContent.classList.add('show');
                        ordersDropdownArrow.classList.add('rotate-180');
                        localStorage.setItem('ordersDropdownState', 'open');
                    }
                }
            });

            // Предотвратяване на затваряне при клик върху съдържанието на Orders dropdown
            ordersDropdownContent.addEventListener('click', function(e) {
                e.stopPropagation();
            });
        }

        // Инициализирай Orders dropdown при зареждане
        document.addEventListener('DOMContentLoaded', function() {
            initializeOrdersDropdown();
        });

        // Dropdown functionality for other sidebar dropdowns (ако имаш други в бъдеще)
        document.querySelectorAll('.sidebar-dropdown').forEach(dropdown => {
            // Пропусни Orders dropdown, тъй като той вече е обработен
            if (dropdown === document.querySelector('.sidebar-dropdown')) return;

            const button = dropdown.querySelector('button');
            const content = dropdown.querySelector('.sidebar-dropdown-content');
            const arrow = dropdown.querySelector('.dropdown-arrow');

            button?.addEventListener('click', function(e) {
                // Only toggle if sidebar is not collapsed
                if (!adminSidebar.classList.contains('collapsed')) {
                    e.stopPropagation();
                    const isOpen = content.classList.contains('show');

                    // Close all other dropdowns (без Orders)
                    document.querySelectorAll('.sidebar-dropdown').forEach(otherDropdown => {
                        if (otherDropdown !== dropdown && otherDropdown !== document.querySelector('.sidebar-dropdown')) {
                            const otherContent = otherDropdown.querySelector('.sidebar-dropdown-content');
                            const otherArrow = otherDropdown.querySelector('.dropdown-arrow');
                            otherContent?.classList.remove('show');
                            otherArrow?.classList.remove('rotate-180');
                        }
                    });

                    // Toggle current dropdown
                    if (!isOpen) {
                        content.classList.add('show');
                        arrow?.classList.add('rotate-180');
                    } else {
                        content.classList.remove('show');
                        arrow?.classList.remove('rotate-180');
                    }
                }
            });
        });

        // Close sidebar dropdowns when clicking outside (само за не-Orders dropdowns)
        document.addEventListener('click', function(event) {
            const ordersDropdown = document.querySelector('.sidebar-dropdown');
            const clickedInsideOrdersDropdown = ordersDropdown?.contains(event.target);

            if (!clickedInsideOrdersDropdown) {
                // Затвори всички dropdowns освен Orders
                document.querySelectorAll('.sidebar-dropdown').forEach(dropdown => {
                    if (dropdown !== ordersDropdown) {
                        const content = dropdown.querySelector('.sidebar-dropdown-content');
                        const arrow = dropdown.querySelector('.dropdown-arrow');
                        content?.classList.remove('show');
                        arrow?.classList.remove('rotate-180');
                    }
                });
            }
        });

        // Search functionality
        const searchInput = document.querySelector('.admin-search-input');
        if (searchInput) {
            searchInput.addEventListener('focus', function() {
                this.parentElement.classList.add('search-focused');
            });

            searchInput.addEventListener('blur', function() {
                this.parentElement.classList.remove('search-focused');
            });
        }

        // User dropdown functionality
        const userMenuButton = document.getElementById('userMenuButton');
        const userDropdownMenu = document.querySelector('.user-dropdown-menu');

        if (userMenuButton && userDropdownMenu) {
            userMenuButton.addEventListener('click', function(e) {
                e.stopPropagation();
                const isOpen = userDropdownMenu.classList.contains('show');

                // Toggle current dropdown
                if (!isOpen) {
                    userDropdownMenu.classList.add('show');
                    // Rotate the chevron icon
                    this.querySelector('i.fa-chevron-down').classList.add('rotate-180');
                } else {
                    userDropdownMenu.classList.remove('show');
                    this.querySelector('i.fa-chevron-down').classList.remove('rotate-180');
                }
            });
        }

        // Close user dropdown when clicking outside
        document.addEventListener('click', function(event) {
            if (!event.target.closest('#userMenu')) {
                userDropdownMenu?.classList.remove('show');
                // Reset chevron icon
                const chevron = userMenuButton?.querySelector('i.fa-chevron-down');
                chevron?.classList.remove('rotate-180');
            }
        });

        // Close dropdown when pressing Escape key
        document.addEventListener('keydown', function(event) {
            if (event.key === 'Escape') {
                userDropdownMenu?.classList.remove('show');
                // Reset chevron icon
                const chevron = userMenuButton?.querySelector('i.fa-chevron-down');
                chevron?.classList.remove('rotate-180');
            }
        });

        // Close mobile sidebar when clicking on a link (mobile only)
        document.querySelectorAll('.sidebar-nav-item, .sidebar-dropdown-item').forEach(link => {
            link.addEventListener('click', function() {
                if (window.innerWidth <= 768) {
                    document.querySelector('.admin-sidebar').classList.remove('mobile-open');
                }
            });
        });
    </script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>