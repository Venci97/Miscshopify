@using Miscshopify.Core.Models;
@model IEnumerable<CategoryViewModel>
@{
    var parentCategoryName = ViewBag.ParentCategoryName;
    var parentCategoryId = ViewBag.ParentCategoryId;
    ViewData["Title"] = "Subcategories Management";
}

<link href="~/css/admin/category-index.css" rel="stylesheet" />

<div class="category-index-section">
    <div class="category-header">
        <h1 class="category-title">
            <i class="fas fa-folder-open"></i>
            Subcategories of @parentCategoryName
        </h1>
        <div class="category-actions">
            <a href="@Url.Action("Index")" class="btn btn-secondary">
                <i class="fas fa-arrow-left"></i>
                Back to Categories
            </a>
            <a href="@Url.Action("Add")" class="btn btn-primary">
                <i class="fas fa-plus-circle"></i>
                Add New Subcategory
            </a>
            <a href="@Url.Action("Add", "Product", new { Id = parentCategoryId })" class="btn btn-success">
                <i class="fas fa-plus"></i>
                Add Product to @parentCategoryName
            </a>
        </div>
    </div>

    <div class="category-card">
        <div class="card-content">
            <div class="table-container">
                @if (Model.Any())
                {
                    <table class="category-table">
                        <thead>
                            <tr>
                                <th style="width: 80px;">Image</th>
                                <th>Name</th>
                                <th>Description</th>
                                <th>Products</th>
                                <th style="width: 250px;">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var subcategory in Model)
                            {
                                <tr>
                                    <td class="category-image-cell">
                                        <div class="category-image-container">
                                            @if (!string.IsNullOrEmpty(subcategory.ImagePath))
                                            {
                                                <img src="@Url.Content($"/{subcategory.ImagePath}")"
                                                     class="category-image"
                                                     alt="@subcategory.Name"
                                                     onerror="this.style.display='none'; this.nextElementSibling.style.display='flex';" />
                                                <div class="category-image-placeholder" style="display: none;">
                                                    <i class="fas fa-folder"></i>
                                                </div>
                                            }
                                            else
                                            {
                                                <div class="category-image-placeholder">
                                                    <i class="fas fa-folder"></i>
                                                </div>
                                            }
                                        </div>
                                    </td>
                                    <td class="category-name">@subcategory.Name</td>
                                    <td class="category-description">@subcategory.Description</td>
                                    <td>
                                        <div class="stat-number">@subcategory.ProductsCount</div>
                                    </td>
                                    <td>
                                        <div class="action-buttons">
                                            <a href="@Url.Action("Edit", new { id = subcategory.Id })" class="btn-warning">
                                                <i class="fas fa-edit"></i>
                                                Edit
                                            </a>
                                            <a href="@Url.Action("Add", "Product", new { Id = subcategory.Id })" class="btn-success">
                                                <i class="fas fa-plus"></i>
                                                Add Product
                                            </a>
                                            <a href="@Url.Action("RemoveCategoryWithProducts", new { Id = subcategory.Id })" class="btn-danger"
                                               onclick="return confirm('Are you sure you want to delete this subcategory and all its products?')">
                                                <i class="fas fa-trash"></i>
                                                Delete
                                            </a>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
                else
                {
                    <div class="empty-state">
                        <i class="fas fa-folder-open"></i>
                        <h3>No Subcategories Found</h3>
                        <p>There are no subcategories in @parentCategoryName yet.</p>
                        <div class="mt-3">
                            <a href="@Url.Action("Add")" class="btn btn-primary">
                                <i class="fas fa-plus-circle"></i>
                                Add First Subcategory
                            </a>
                            <a href="@Url.Action("Add", "Product", new { Id = parentCategoryId })" class="btn btn-success">
                                <i class="fas fa-plus"></i>
                                Add Product to @parentCategoryName
                            </a>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            const rows = document.querySelectorAll('.category-table tbody tr');

            rows.forEach((row, index) => {
                // Add staggered animation
                row.style.animationDelay = `${(index + 1) * 0.1}s`;

                // Add click effect
                row.addEventListener('click', function(e) {
                    if (!e.target.closest('a')) {
                        this.style.transform = 'scale(0.99)';
                        setTimeout(() => {
                            this.style.transform = '';
                        }, 150);
                    }
                });
            });

            // Enhanced image error handling
            document.querySelectorAll('.category-image').forEach(img => {
                img.addEventListener('error', function() {
                    console.log('Image failed to load:', this.src);
                    this.style.display = 'none';
                    const placeholder = this.nextElementSibling;
                    if (placeholder) {
                        placeholder.style.display = 'flex';
                    }
                });

                // Log successful image loads
                img.addEventListener('load', function() {
                    console.log('Image loaded successfully:', this.src);
                });
            });

            // Add confirmation for delete buttons
            const deleteButtons = document.querySelectorAll('.btn-danger');
            deleteButtons.forEach(button => {
                button.addEventListener('click', function(e) {
                    if (!confirm('Are you sure you want to delete this subcategory and all its products?')) {
                        e.preventDefault();
                    }
                });
            });

            console.log('Subcategories management loaded successfully');
        });
    </script>
}