@page
@model LoginWith2faModel
@{
    ViewData["Title"] = "Two-factor authentication";
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Two-Factor Authentication - Modern Store</title>

    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
</head>
<body class="min-h-screen bg-gradient-to-br from-blue-50 to-indigo-100 flex items-center justify-center p-4" style="font-family: 'Inter', sans-serif;">
    <div class="max-w-md w-full">
        <div class="bg-white rounded-2xl shadow-xl p-8">
            <!-- Header -->
            <div class="text-center mb-8">
                <div class="w-16 h-16 bg-blue-100 rounded-2xl flex items-center justify-center mx-auto mb-4">
                    <i class="fas fa-shield-alt text-blue-600 text-2xl"></i>
                </div>
                <h1 class="text-3xl font-bold text-gray-900 mb-2">Two-Factor Authentication</h1>
                <p class="text-gray-600">Your login is protected with an authenticator app</p>
            </div>

            <!-- Validation Summary -->
            <div asp-validation-summary="ModelOnly" class="mb-4 p-4 bg-red-50 border border-red-200 rounded-lg text-red-700"></div>

            <form method="post" asp-route-returnUrl="@Model.ReturnUrl" class="space-y-6">
                <input asp-for="RememberMe" type="hidden" />

                <!-- Two Factor Code -->
                <div class="space-y-2">
                    <label asp-for="Input.TwoFactorCode" class="block text-sm font-medium text-gray-700">
                        <i class="fas fa-mobile-alt mr-2 text-blue-500"></i>Authenticator Code
                    </label>
                    <input asp-for="Input.TwoFactorCode"
                           autocomplete="off"
                           aria-required="true"
                           class="w-full px-4 py-3 border-2 border-gray-200 rounded-lg focus:outline-none focus:border-blue-500 focus:ring-2 focus:ring-blue-200 transition-all duration-300"
                           placeholder="Enter 6-digit code" />
                    <span asp-validation-for="Input.TwoFactorCode" class="text-red-600 text-sm"></span>
                </div>

                <!-- Remember Machine -->
                <div class="flex items-center space-x-2">
                    <input class="h-4 w-4 text-blue-600 focus:ring-blue-500 border-gray-300 rounded"
                           asp-for="Input.RememberMachine" />
                    <label asp-for="Input.RememberMachine" class="text-sm text-gray-700 cursor-pointer">
                        Remember this device
                    </label>
                </div>

                <!-- Login Button -->
                <button type="submit"
                        class="w-full bg-gradient-to-r from-blue-600 to-indigo-600 text-white py-3 px-4 rounded-lg font-semibold text-lg hover:from-blue-700 hover:to-indigo-700 transform hover:-translate-y-0.5 transition-all duration-300 shadow-lg hover:shadow-xl">
                    <i class="fas fa-sign-in-alt mr-2"></i>Verify & Continue
                </button>
            </form>

            <!-- Recovery Code Option -->
            <div class="mt-6 p-4 bg-gray-50 rounded-lg border border-gray-200">
                <div class="flex items-start space-x-3">
                    <i class="fas fa-key text-orange-500 mt-1"></i>
                    <div>
                        <p class="text-sm text-gray-700 mb-2">
                            Don't have access to your authenticator device?
                        </p>
                        <a id="recovery-code-login"
                           asp-page="./LoginWithRecoveryCode"
                           asp-route-returnUrl="@Model.ReturnUrl"
                           class="text-blue-600 hover:text-blue-700 font-medium text-sm inline-flex items-center gap-1 transition-colors">
                            <i class="fas fa-unlock-alt"></i>
                            Log in with a recovery code
                        </a>
                    </div>
                </div>
            </div>

            <!-- Help Text -->
            <div class="mt-6 text-center">
                <p class="text-xs text-gray-500">
                    <i class="fas fa-info-circle mr-1"></i>
                    Open your authenticator app to get the verification code
                </p>
            </div>
        </div>
    </div>

    <partial name="_ValidationScriptsPartial" />

    <style>
        .form-input {
            transition: all 0.3s ease;
        }

        .form-input:focus {
            transform: translateY(-2px);
            box-shadow: 0 10px 25px rgba(59, 130, 246, 0.1);
        }

        /* Animation for the security icon */
        @@keyframes pulse-gentle {
            0%, 100% {
                transform: scale(1);
            }
            50% {
                transform: scale(1.05);
            }
        }

        .fa-shield-alt {
            animation: pulse-gentle 2s ease-in-out infinite;
        }
    </style>
</body>
</html>