@page
@model ForgotPasswordModel
@{
    ViewData["Title"] = "Forgot your password?";
}

<div class="forgot-password-page">
    <div class="password-container">
        <div class="password-header">
            <div class="password-icon">
                <i class="fas fa-key"></i>
            </div>
            <h1 class="page-title">@ViewData["Title"]</h1>
            <h2 class="page-subtitle">Enter your email to reset your password</h2>
        </div>

        <div class="info-message">
            <i class="fas fa-info-circle"></i>
            <div>
                <p>
                    <strong>Forgot your password?</strong> No problem. Just enter your email address below
                    and we'll send you a link to reset your password.
                </p>
            </div>
        </div>

        <div class="password-form-container">
            <form method="post" class="password-form">
                <div asp-validation-summary="ModelOnly" class="validation-summary"></div>

                <div class="form-group">
                    <label asp-for="Input.Email" class="form-label">Email Address</label>
                    <input asp-for="Input.Email" class="form-input" autocomplete="username" aria-required="true"
                           placeholder="Enter your email address" />
                    <span asp-validation-for="Input.Email" class="validation-error"></span>
                </div>

                <button type="submit" class="submit-btn primary">
                    <i class="fas fa-paper-plane"></i>
                    Send Reset Link
                </button>
            </form>
        </div>

        <div class="additional-info">
            <div class="info-item">
                <i class="fas fa-envelope"></i>
                <div>
                    <strong>Check your inbox</strong>
                    <span>We'll send a password reset link to your email</span>
                </div>
            </div>
            <div class="info-item">
                <i class="fas fa-clock"></i>
                <div>
                    <strong>Link expires</strong>
                    <span>The reset link is valid for a limited time</span>
                </div>
            </div>
            <div class="info-item">
                <i class="fas fa-shield-alt"></i>
                <div>
                    <strong>Secure process</strong>
                    <span>Your information is protected and secure</span>
                </div>
            </div>
        </div>

        <div class="back-to-login">
            <a asp-page="./Login" class="back-link">
                <i class="fas fa-arrow-left"></i>
                Back to Sign In
            </a>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        document.addEventListener('DOMContentLoaded', function() {
            const emailInput = document.querySelector('input[name="Input.Email"]');

            if (emailInput) {
                emailInput.addEventListener('focus', function() {
                    if (this.value === '') {
                        this.removeAttribute('placeholder');
                    }
                });

                emailInput.addEventListener('blur', function() {
                    if (this.value === '') {
                        this.setAttribute('placeholder', 'Enter your email address');
                    }
                });
            }

            // Form submission feedback
            const form = document.querySelector('.password-form');
            if (form) {
                form.addEventListener('submit', function(e) {
                    const button = this.querySelector('button[type="submit"]');
                    if (button) {
                        button.disabled = true;
                        button.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Sending Reset Link...';
                    }
                });
            }
        });
    </script>
}

<style>
    .forgot-password-page {
        min-height: 80vh;
        display: flex;
        align-items: center;
        justify-content: center;
        background: linear-gradient(135deg, #f8fafc 0%, #f1f5f9 100%);
        padding: 2rem;
    }

    .password-container {
        background: white;
        border-radius: 1rem;
        box-shadow: 0 10px 25px rgba(0, 0, 0, 0.1);
        padding: 3rem;
        max-width: 500px;
        width: 100%;
        text-align: center;
        border-left: 4px solid #f59e0b;
    }

    .password-header {
        margin-bottom: 2rem;
    }

    .password-icon {
        font-size: 3rem;
        color: #f59e0b;
        margin-bottom: 1rem;
    }

    .page-title {
        font-size: 2rem;
        font-weight: 700;
        color: #1f2937;
        margin-bottom: 0.5rem;
    }

    .page-subtitle {
        font-size: 1.125rem;
        font-weight: 500;
        color: #6b7280;
        margin-bottom: 0;
    }

    .info-message {
        display: flex;
        align-items: flex-start;
        gap: 1rem;
        background: #fffbeb;
        border: 1px solid #fcd34d;
        border-radius: 0.75rem;
        padding: 1.5rem;
        margin-bottom: 2rem;
        text-align: left;
    }

        .info-message i {
            color: #d97706;
            font-size: 1.25rem;
            margin-top: 0.125rem;
            flex-shrink: 0;
        }

        .info-message p {
            color: #92400e;
            margin: 0;
            line-height: 1.5;
        }

    .password-form-container {
        margin-bottom: 2rem;
    }

    .password-form {
        text-align: left;
    }

    .form-group {
        display: flex;
        flex-direction: column;
        gap: 0.5rem;
        margin-bottom: 1.5rem;
    }

    .form-label {
        font-weight: 600;
        color: #374151;
        margin-bottom: 0.5rem;
    }

    .form-input {
        padding: 0.75rem 1rem;
        border: 1px solid #d1d5db;
        border-radius: 0.5rem;
        font-size: 1rem;
        transition: all 0.2s ease;
    }

        .form-input:focus {
            outline: none;
            border-color: #f59e0b;
            box-shadow: 0 0 0 3px rgba(245, 158, 11, 0.1);
        }

        .form-input::placeholder {
            color: #9ca3af;
            font-style: italic;
        }

    .submit-btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 0.5rem;
        padding: 0.75rem 1.5rem;
        border-radius: 0.5rem;
        font-weight: 600;
        text-decoration: none;
        transition: all 0.2s ease;
        border: none;
        cursor: pointer;
        font-size: 1rem;
        width: 100%;
    }

        .submit-btn.primary {
            background: #f59e0b;
            color: white;
        }

            .submit-btn.primary:hover:not(:disabled) {
                background: #d97706;
                transform: translateY(-1px);
            }

        .submit-btn:disabled {
            background: #9ca3af;
            cursor: not-allowed;
            transform: none;
        }

    .additional-info {
        background: #f8fafc;
        border: 1px solid #e5e7eb;
        border-radius: 0.75rem;
        padding: 1.5rem;
        margin-bottom: 1.5rem;
    }

    .info-item {
        display: flex;
        align-items: flex-start;
        gap: 1rem;
        margin-bottom: 1rem;
    }

        .info-item:last-child {
            margin-bottom: 0;
        }

        .info-item i {
            color: #f59e0b;
            margin-top: 0.125rem;
            flex-shrink: 0;
        }

        .info-item div {
            display: flex;
            flex-direction: column;
            gap: 0.25rem;
            text-align: left;
        }

        .info-item strong {
            color: #374151;
            font-size: 0.9rem;
        }

        .info-item span {
            color: #6b7280;
            font-size: 0.875rem;
            line-height: 1.4;
        }

    .back-to-login {
        text-align: center;
    }

    .back-link {
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        color: #6b7280;
        text-decoration: none;
        font-weight: 500;
        transition: color 0.2s ease;
    }

        .back-link:hover {
            color: #374151;
            text-decoration: none;
        }

    .validation-summary {
        color: #dc2626;
        background: #fef2f2;
        padding: 1rem;
        border-radius: 8px;
        border: 1px solid #fecaca;
        margin-bottom: 1.5rem;
    }

    .validation-error {
        color: #dc2626;
        font-size: 0.875rem;
        margin-top: 0.25rem;
    }

    /* Responsive Design */
    @@media (max-width: 768px) {
        .forgot-password-page {
            padding: 1rem;
        }

        .password-container {
            padding: 2rem;
        }

        .page-title {
            font-size: 1.5rem;
        }

        .page-subtitle {
            font-size: 1rem;
        }

        .info-message {
            flex-direction: column;
            text-align: center;
            gap: 0.75rem;
        }

        .info-item {
            flex-direction: column;
            text-align: center;
            gap: 0.5rem;
        }

            .info-item div {
                text-align: center;
            }
    }

    @@media (max-width: 480px) {
        .password-container {
            padding: 1.5rem;
        }

        .password-icon {
            font-size: 2.5rem;
        }

        .info-message {
            padding: 1rem;
        }

        .additional-info {
            padding: 1rem;
        }
    }
</style>