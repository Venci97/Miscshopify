@model string

@if (!String.IsNullOrEmpty(Model))
{
    var statusMessageClass = Model.StartsWith("Error") ? "error" : "success";
    var statusIcon = Model.StartsWith("Error") ? "fa-exclamation-circle" : "fa-check-circle";

    <div class="status-message @statusMessageClass">
        <i class="fas @statusIcon"></i>
        <span>@Model</span>
    </div>

    <style>
        .status-message {
            padding: 1rem 1.5rem;
            border-radius: 0.75rem;
            margin-bottom: 1.5rem;
            font-weight: 500;
            display: flex;
            align-items: flex-start;
            gap: 0.75rem;
            animation: slideIn 0.3s ease-out;
        }

            .status-message.success {
                background: #d1fae5;
                color: #065f46;
                border: 1px solid #a7f3d0;
            }

            .status-message.error {
                background: #fef2f2;
                color: #dc2626;
                border: 1px solid #fecaca;
            }

            .status-message i {
                font-size: 1.25rem;
                margin-top: 0.125rem;
                flex-shrink: 0;
            }

            .status-message span {
                line-height: 1.5;
            }

        @@keyframes slideIn {
            from {
                opacity: 0;
                transform: translateY(-10px);
            }

            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        /* Responsive adjustments */
        @@media (max-width: 768px) {
            .status-message {
                padding: 1rem;
                flex-direction: column;
                align-items: flex-start;
                gap: 0.5rem;
            }

                .status-message i {
                    align-self: flex-start;
                }
        }
    </style>
}