@page
@model ConfirmEmailModel
@{
    ViewData["Title"] = "Confirm email";
}

<div class="confirm-email-page">
    <div class="confirmation-container">
        <div class="confirmation-icon">
            <i class="fas fa-envelope-circle-check"></i>
        </div>

        <div class="confirmation-content">
            <h1 class="confirmation-title">Email Confirmation</h1>
            <partial name="_StatusMessage" model="Model.StatusMessage" />

            <div class="confirmation-details">
                <div class="detail-item">
                    <i class="fas fa-check-circle"></i>
                    <span>Your email address has been successfully verified</span>
                </div>
                <div class="detail-item">
                    <i class="fas fa-user-check"></i>
                    <span>Your account is now fully activated</span>
                </div>
                <div class="detail-item">
                    <i class="fas fa-shield-alt"></i>
                    <span>You can now access all features of your account</span>
                </div>
            </div>

            <div class="action-buttons">
                <a href="~/" class="action-btn primary">
                    <i class="fas fa-home"></i>
                    Go to Homepage
                </a>
                <a asp-page="./Login" class="action-btn secondary">
                    <i class="fas fa-sign-in-alt"></i>
                    Sign In to Your Account
                </a>
            </div>
        </div>
    </div>
</div>

<style>
    .confirm-email-page {
        min-height: 80vh;
        display: flex;
        align-items: center;
        justify-content: center;
        background: linear-gradient(135deg, #f0f9ff 0%, #e0f2fe 100%);
        padding: 2rem;
    }

    .confirmation-container {
        background: white;
        border-radius: 1rem;
        box-shadow: 0 10px 25px rgba(0, 0, 0, 0.1);
        padding: 3rem;
        max-width: 500px;
        width: 100%;
        text-align: center;
        border-left: 4px solid #10b981;
    }

    .confirmation-icon {
        font-size: 4rem;
        color: #10b981;
        margin-bottom: 1.5rem;
    }

    .confirmation-title {
        font-size: 2rem;
        font-weight: 700;
        color: #1f2937;
        margin-bottom: 1.5rem;
    }

    .confirmation-details {
        background: #ecfdf5;
        border-radius: 0.75rem;
        padding: 1.5rem;
        margin: 2rem 0;
        text-align: left;
    }

    .detail-item {
        display: flex;
        align-items: flex-start;
        gap: 0.75rem;
        margin-bottom: 1rem;
    }

        .detail-item:last-child {
            margin-bottom: 0;
        }

        .detail-item i {
            color: #10b981;
            margin-top: 0.125rem;
            flex-shrink: 0;
        }

        .detail-item span {
            color: #065f46;
            line-height: 1.5;
            font-weight: 500;
        }

    .action-buttons {
        display: flex;
        flex-direction: column;
        gap: 1rem;
    }

    .action-btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 0.5rem;
        padding: 0.75rem 1.5rem;
        border-radius: 0.5rem;
        font-weight: 600;
        text-decoration: none;
        transition: all 0.2s ease;
        border: none;
        cursor: pointer;
        font-size: 0.9rem;
    }

        .action-btn.primary {
            background: #10b981;
            color: white;
        }

            .action-btn.primary:hover {
                background: #059669;
                transform: translateY(-1px);
            }

        .action-btn.secondary {
            background: #f3f4f6;
            color: #374151;
            border: 1px solid #d1d5db;
        }

            .action-btn.secondary:hover {
                background: #e5e7eb;
                transform: translateY(-1px);
            }

    /* Responsive Design */
    @@media (max-width: 768px) {
        .confirm-email-page {
            padding: 1rem;
        }

        .confirmation-container {
            padding: 2rem;
        }

        .confirmation-title {
            font-size: 1.5rem;
        }

        .confirmation-details {
            padding: 1rem;
        }

        .detail-item {
            flex-direction: column;
            text-align: center;
            gap: 0.5rem;
        }

        .action-buttons {
            gap: 0.75rem;
        }
    }

    @@media (max-width: 480px) {
        .confirmation-container {
            padding: 1.5rem;
        }

        .confirmation-icon {
            font-size: 3rem;
        }

        .action-btn {
            padding: 0.75rem 1rem;
            font-size: 0.85rem;
        }
    }
</style>