@page
@model LoginModel

@{
    ViewData["Title"] = "Log in";
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Login - Modern Store</title>

    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
</head>
<body class="login-page flex items-center justify-center p-4">
    <div class="login-container w-full max-w-md p-8">
        <!-- Header -->
        <div class="text-center mb-8">
            <div class="w-16 h-16 bg-indigo-100 rounded-2xl flex items-center justify-center mx-auto mb-4">
                <i class="fas fa-lock text-indigo-600 text-2xl"></i>
            </div>
            <h1 class="text-3xl font-bold text-gray-900 mb-2">Welcome Back</h1>
            <p class="text-gray-600">Sign in to your account</p>
        </div>

        <!-- Validation Summary -->
        <div asp-validation-summary="ModelOnly" class="mb-4 p-4 bg-red-50 border border-red-200 rounded-lg text-red-700"></div>

        <form id="account" method="post" class="space-y-6">
            <!-- Email Field -->
            <div class="space-y-2">
                <label asp-for="Input.Email" class="block text-sm font-medium text-gray-700">
                    <i class="fas fa-envelope mr-2 text-indigo-500"></i>Email Address
                </label>
                <input asp-for="Input.Email"
                       autocomplete="username"
                       aria-required="true"
                       class="w-full px-4 py-3 form-input rounded-lg focus:outline-none focus:ring-2 focus:ring-indigo-500"
                       placeholder="Enter your email" />
                <span asp-validation-for="Input.Email" class="text-red-600 text-sm"></span>
            </div>

            <!-- Password Field -->
            <div class="space-y-2">
                <label asp-for="Input.Password" class="block text-sm font-medium text-gray-700">
                    <i class="fas fa-lock mr-2 text-indigo-500"></i>Password
                </label>
                <input asp-for="Input.Password"
                       autocomplete="current-password"
                       aria-required="true"
                       class="w-full px-4 py-3 form-input rounded-lg focus:outline-none focus:ring-2 focus:ring-indigo-500"
                       placeholder="Enter your password" />
                <span asp-validation-for="Input.Password" class="text-red-600 text-sm"></span>
            </div>

            <!-- Remember Me & Forgot Password -->
            <div class="flex items-center justify-between">
                <label class="flex items-center space-x-2 cursor-pointer">
                    <input class="form-check-input h-4 w-4 text-indigo-600 focus:ring-indigo-500 border-gray-300 rounded"
                           asp-for="Input.RememberMe" />
                    <span class="text-sm text-gray-700">Remember me</span>
                </label>
                <a id="forgot-password" asp-page="./ForgotPassword"
                   class="text-sm text-indigo-600 hover:text-indigo-500 transition-colors">
                    Forgot password?
                </a>
            </div>

            <!-- Login Button -->
            <button id="login-submit" type="submit"
                    class="w-full login-btn text-white py-3 px-4 rounded-lg font-semibold text-lg">
                <i class="fas fa-sign-in-alt mr-2"></i>Sign In
            </button>

            <!-- Divider -->
            <div class="relative my-6">
                <div class="absolute inset-0 flex items-center">
                    <div class="w-full border-t border-gray-300"></div>
                </div>
                <div class="relative flex justify-center text-sm">
                    <span class="px-2 bg-white text-gray-500">New to our platform?</span>
                </div>
            </div>

            <!-- Register Link -->
            <div class="text-center">
                <a asp-page="./Register" asp-route-returnUrl="@Model.ReturnUrl"
                   class="social-login-btn w-full bg-white text-gray-700 py-3 px-4 rounded-lg font-semibold inline-flex items-center justify-center gap-2 hover:bg-gray-50">
                    <i class="fas fa-user-plus text-indigo-500"></i>
                    Create New Account
                </a>
            </div>
        </form>

        <!-- Support Info -->
        <div class="mt-8 text-center">
            <p class="text-xs text-gray-500">
                Having trouble?
                <a href="#" class="text-indigo-600 hover:text-indigo-500">Contact support</a>
            </p>
        </div>
    </div>

    <partial name="_ValidationScriptsPartial" />

    <style>
        .login-page {
            min-height: 100vh;
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            font-family: 'Inter', sans-serif;
        }

        .login-container {
            background: rgba(255, 255, 255, 0.95);
            backdrop-filter: blur(10px);
            border-radius: 1.5rem;
            box-shadow: 0 20px 40px rgba(0, 0, 0, 0.1);
            border: 1px solid rgba(255, 255, 255, 0.2);
        }

        .form-input {
            transition: all 0.3s ease;
            border: 2px solid #e5e7eb;
        }

            .form-input:focus {
                border-color: #4f46e5;
                box-shadow: 0 0 0 3px rgba(79, 70, 229, 0.1);
                transform: translateY(-2px);
            }

        .login-btn {
            background: linear-gradient(135deg, #4f46e5 0%, #7c3aed 100%);
            transition: all 0.3s ease;
        }

            .login-btn:hover {
                transform: translateY(-2px);
                box-shadow: 0 10px 25px rgba(79, 70, 229, 0.3);
            }

        .social-login-btn {
            transition: all 0.3s ease;
            border: 2px solid #e5e7eb;
        }

            .social-login-btn:hover {
                transform: translateY(-2px);
                border-color: #4f46e5;
            }
    </style>
</body>
</html>