@page
@model RegisterConfirmationModel
@{
    ViewData["Title"] = "Register confirmation";
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Register Confirmation - Modern Store</title>

    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
</head>
<body class="min-h-screen bg-gradient-to-br from-blue-50 to-indigo-100 flex items-center justify-center p-4" style="font-family: 'Inter', sans-serif;">
    <div class="max-w-md w-full">
        <div class="bg-white rounded-2xl shadow-xl p-8 text-center">
            <!-- Header -->
            <div class="mb-8">
                <div class="w-20 h-20 bg-blue-100 rounded-2xl flex items-center justify-center mx-auto mb-4">
                    @if (Model.DisplayConfirmAccountLink)
                    {
                        <i class="fas fa-envelope-open-text text-blue-600 text-3xl"></i>
                    }
                    else
                    {
                        <i class="fas fa-envelope text-blue-600 text-3xl"></i>
                    }
                </div>
                <h1 class="text-3xl font-bold text-gray-900 mb-2">Confirm Your Email</h1>
                <p class="text-gray-600">Almost there! Just one more step</p>
            </div>

            @if (Model.DisplayConfirmAccountLink)
            {
                <!-- Development Mode - Show Direct Link -->
                <div class="mb-6 p-4 bg-yellow-50 border border-yellow-200 rounded-lg text-left">
                    <div class="flex items-start space-x-3">
                        <i class="fas fa-info-circle text-yellow-500 mt-0.5"></i>
                        <div class="text-sm text-yellow-800">
                            <p class="font-medium mb-1">Development Mode</p>
                            <p>This app does not currently have a real email sender registered.</p>
                        </div>
                    </div>
                </div>

                <p class="text-gray-700 mb-6">
                    Normally this confirmation would be sent via email. For development purposes, you can confirm your account using the link below:
                </p>

                <a id="confirm-link" href="@Model.EmailConfirmationUrl"
                   class="w-full bg-gradient-to-r from-blue-600 to-indigo-600 text-white py-3 px-4 rounded-lg font-semibold text-lg hover:from-blue-700 hover:to-indigo-700 transform hover:-translate-y-0.5 transition-all duration-300 shadow-lg hover:shadow-xl inline-flex items-center justify-center gap-2 mb-4">
                    <i class="fas fa-check-circle mr-2"></i>
                    Confirm Your Account
                </a>

                <div class="mt-4 p-4 bg-gray-50 rounded-lg border border-gray-200">
                    <div class="flex items-start space-x-3">
                        <i class="fas fa-book text-gray-500 mt-0.5"></i>
                        <div class="text-sm text-gray-700">
                            <p class="font-medium mb-1">Need to set up email?</p>
                            <p>See <a href="https://aka.ms/aspaccountconf" class="text-blue-600 hover:text-blue-700 underline" target="_blank">these docs</a> for how to configure a real email sender.</p>
                        </div>
                    </div>
                </div>
            }
            else
            {
                <!-- Production Mode - Check Email -->
                <div class="mb-6 p-4 bg-green-50 border border-green-200 rounded-lg">
                    <div class="flex items-center justify-center space-x-2 text-green-700">
                        <i class="fas fa-check-circle"></i>
                        <span class="font-medium">Confirmation Email Sent!</span>
                    </div>
                </div>

                <p class="text-gray-700 mb-6">
                    We've sent a confirmation link to your email address. Please check your inbox and click the link to activate your account.
                </p>

                <div class="space-y-3">
                    <div class="p-4 bg-blue-50 rounded-lg border border-blue-200">
                        <div class="flex items-center justify-center space-x-2 text-blue-700">
                            <i class="fas fa-envelope"></i>
                            <span class="font-medium">Check your spam folder</span>
                        </div>
                        <p class="text-sm text-blue-600 mt-1">If you don't see the email, please check your spam or junk folder.</p>
                    </div>
                </div>
            }

            <!-- Additional Help -->
            <div class="mt-8 pt-6 border-t border-gray-200">
                <p class="text-sm text-gray-600 mb-4">Need help?</p>
                <div class="flex flex-col sm:flex-row gap-3 justify-center">
                    <a href="/"
                       class="flex-1 border-2 border-gray-300 text-gray-700 py-2 px-4 rounded-lg font-medium hover:border-blue-500 hover:text-blue-600 hover:bg-blue-50 transition-all duration-300 inline-flex items-center justify-center gap-2">
                        <i class="fas fa-home"></i>
                        Home
                    </a>
                    <a asp-page="./Login"
                       class="flex-1 border-2 border-gray-300 text-gray-700 py-2 px-4 rounded-lg font-medium hover:border-blue-500 hover:text-blue-600 hover:bg-blue-50 transition-all duration-300 inline-flex items-center justify-center gap-2">
                        <i class="fas fa-sign-in-alt"></i>
                        Sign In
                    </a>
                </div>
            </div>

            <!-- Security Note -->
            <div class="mt-6 text-center">
                <div class="flex items-center justify-center gap-2 text-xs text-gray-500">
                    <i class="fas fa-shield-alt"></i>
                    <span>Your account security is our priority</span>
                </div>
            </div>
        </div>
    </div>

    <style>
        /* Smooth animations */
        .fa-envelope-open-text, .fa-envelope {
            animation: bounceGentle 2s ease-in-out infinite;
        }

        @@keyframes bounceGentle {
            0%, 100% {
                transform: scale(1) translateY(0);
            }

            50% {
                transform: scale(1.05) translateY(-2px);
            }
        }

        /* Button hover effects */
        a, button {
            transition: all 0.3s ease;
        }
    </style>
</body>
</html>