    }

    /* Responsive Design */
    @@media (max-width: 768px) {
        .manage-form {
            padding: 1.5rem;
        }

        .warning-header {
            flex-direction: column;
            text-align: center;
            gap: 0.5rem;
            padding: 1rem;
        }

        .form-actions {
            flex-direction: column;
            align-items: stretch;
        }

        .submit-btn,
        .cancel-btn {
            justify-content: center;
