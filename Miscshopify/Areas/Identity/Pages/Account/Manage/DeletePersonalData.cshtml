        align-items: center;
        gap: 0.5rem;
        padding: 0.75rem 1.5rem;
        border-radius: 0.5rem;
        font-weight: 500;
        text-decoration: none;
        color: #6b7280;
        background: #f9fafb;
        border: 1px solid #d1d5db;
        transition: all 0.2s ease;
    }

        .cancel-btn:hover {
            background: #f3f4f6;
            color: #374151;
            text-decoration: none;
