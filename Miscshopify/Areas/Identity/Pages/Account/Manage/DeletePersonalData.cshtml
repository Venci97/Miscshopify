        display: flex;
        align-items: flex-start;
        gap: 1rem;
        background: #f0f9ff;
        border: 1px solid #bae6fd;
        border-radius: 8px;
        padding: 1.5rem;
        margin-top: 2rem;
    }

    .options-icon {
        flex-shrink: 0;
        color: #0369a1;
        font-size: 1.5rem;
        margin-top: 0.125rem;
    }

    .options-content h5 {
        color: #0369a1;
        font-weight: 600;
        margin-bottom: 0.75rem;
    }

    .options-content p {
        color: #0369a1;
        margin-bottom: 1rem;
        line-height: 1.5;
    }

    .options-links {
        display: flex;
        flex-direction: column;
        gap: 0.5rem;
    }

    .option-link {
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        color: #0369a1;
        text-decoration: none;
        font-weight: 500;
        padding: 0.5rem 0.75rem;
        background: rgba(255, 255, 255, 0.7);
        border-radius: 6px;
        transition: all 0.2s;
        font-size: 0.9rem;
    }

        .option-link:hover {
            background: white;
            text-decoration: none;
            color: #0369a1;
        }

    .validation-summary {
        color: #dc2626;
        background: #fef2f2;
        padding: 1rem;
        border-radius: 8px;
        border: 1px solid #fecaca;
