@page
@model IndexModel
@{
    ViewData["Title"] = "Profile";
    ViewData["ActivePage"] = ManageNavPages.Index;
}

<div class="profile-section">
    <h3 class="section-title">Profile Information</h3>

    <!-- Custom Status Message with better styling -->
    @if (!string.IsNullOrEmpty(Model.StatusMessage))
    {
        <div class="status-message success">
            <i class="fas fa-check-circle"></i>
            @Model.StatusMessage
        </div>
    }

    <form id="profile-form" method="post" enctype="multipart/form-data">
        <div class="form-grid">
            <!-- Current Profile Picture -->
            <div class="form-group">
                <label class="form-label">Current Profile Picture</label>
                <div class="current-avatar">
                    @if (!string.IsNullOrEmpty(Model.CurrentImagePath))
                    {
                        <img src="@Url.Content(Model.CurrentImagePath)?v=@DateTime.Now.Ticks"
                             class="profile-avatar-preview"
                             alt="Current profile picture"
                             onerror="handleImageError(this)">
                    }
                    else
                    {
                        <div class="no-avatar-placeholder">
                            <i class="fas fa-user-circle"></i>
                            <span>No profile picture</span>
                        </div>
                    }
                </div>
            </div>

            <!-- Upload New Picture -->
            <div class="form-group">
                <label class="form-label">Upload New Picture</label>
                <div class="file-upload-container">
                    <input type="file" asp-for="Input.NewImage"
                           class="file-input"
                           accept=".jpg,.jpeg,.png,.gif"
                           id="imageInput" />
                    <label for="imageInput" class="file-upload-label">
                        <i class="fas fa-cloud-upload-alt"></i>
                        <span id="fileLabelText">Choose Image (JPG, PNG, GIF)</span>
                    </label>
                    <span asp-validation-for="Input.NewImage" class="text-danger"></span>
                </div>
            </div>

            <!-- First Name -->
            <div class="form-group">
                <label asp-for="Input.FirstName" class="form-label">First Name</label>
                <input asp-for="Input.FirstName" class="form-input" />
                <span asp-validation-for="Input.FirstName" class="text-danger"></span>
            </div>

            <!-- Last Name -->
            <div class="form-group">
                <label asp-for="Input.LastName" class="form-label">Last Name</label>
                <input asp-for="Input.LastName" class="form-input" />
                <span asp-validation-for="Input.LastName" class="text-danger"></span>
            </div>

            <!-- Phone Number -->
            <div class="form-group">
                <label asp-for="Input.PhoneNumber" class="form-label">Phone Number</label>
                <input asp-for="Input.PhoneNumber" class="form-input" />
                <span asp-validation-for="Input.PhoneNumber" class="text-danger"></span>
            </div>

            <!-- Address -->
            <div class="form-group">
                <label asp-for="Input.Address" class="form-label">Address</label>
                <input asp-for="Input.Address" class="form-input" placeholder="Enter your street address" />
                <span asp-validation-for="Input.Address" class="text-danger"></span>
            </div>

            <!-- City -->
            <div class="form-group">
                <label asp-for="Input.City" class="form-label">City</label>
                <input asp-for="Input.City" class="form-input" placeholder="Enter your city" />
                <span asp-validation-for="Input.City" class="text-danger"></span>
            </div>

            <!-- Post Code -->
            <div class="form-group">
                <label asp-for="Input.PostCode" class="form-label">Post Code</label>
                <input asp-for="Input.PostCode" class="form-input" placeholder="Enter your post code" />
                <span asp-validation-for="Input.PostCode" class="text-danger"></span>
            </div>
        </div>

        <button id="update-profile-button" type="submit" class="submit-btn">
            <i class="fas fa-save"></i>
            Save Changes
        </button>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        // File input change handler
        document.getElementById('imageInput')?.addEventListener('change', function(e) {
            const file = e.target.files[0];
            const label = document.getElementById('fileLabelText');

            if (file) {
                label.textContent = `Selected: ${file.name}`;
                console.log('File selected:', file.name, file.size);

                // Preview image
                const reader = new FileReader();
                reader.onload = function(e) {
                    const preview = document.querySelector('.profile-avatar-preview');
                    if (preview) {
                        preview.src = e.target.result;
                    } else {
                        // If no preview image exists, create one
                        const currentAvatar = document.querySelector('.current-avatar');
                        const noAvatar = document.querySelector('.no-avatar-placeholder');
                        if (noAvatar) {
                            noAvatar.remove();
                        }
                        const newImg = document.createElement('img');
                        newImg.src = e.target.result;
                        newImg.className = 'profile-avatar-preview';
                        newImg.alt = 'Current profile picture';
                        newImg.onerror = function() { handleImageError(this); };
                        currentAvatar.appendChild(newImg);
                    }
                };
                reader.readAsDataURL(file);
            } else {
                label.textContent = 'Choose Image (JPG, PNG, GIF)';
            }
        });

        // Form submission feedback
        document.getElementById('profile-form')?.addEventListener('submit', function(e) {
            const button = document.getElementById('update-profile-button');
            if (button) {
                button.disabled = true;
                button.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Saving...';
            }
        });

        // Global image error handler
        function handleImageError(img) {
            console.log('Image failed to load:', img.src);
            img.onerror = null;

            // Try to load default avatar
            const defaultPath = '/images/default-avatar.png';
            if (!img.src.includes(defaultPath)) {
                img.src = defaultPath + '?v=' + Date.now();
            } else {
                // If default also fails, show placeholder
                img.style.display = 'none';
                const parent = img.parentElement;
                const placeholder = document.createElement('div');
                placeholder.className = 'no-avatar-placeholder';
                placeholder.innerHTML = '<i class="fas fa-user-circle"></i><span>No profile picture</span>';
                parent.appendChild(placeholder);
            }
        }

        // Apply error handler to all profile images
        document.addEventListener('DOMContentLoaded', function() {
            const images = document.querySelectorAll('.profile-avatar-preview');
            images.forEach(img => {
                img.onerror = function() {
                    handleImageError(this);
                };
            });

            // Force refresh images if we have refresh parameter
            const urlParams = new URLSearchParams(window.location.search);
            if (urlParams.has('refresh')) {
                setTimeout(() => {
                    refreshAllImages();
                }, 500);
            }

            // Add placeholder behavior for address fields
            const addressInputs = document.querySelectorAll('input[placeholder]');
            addressInputs.forEach(input => {
                input.addEventListener('focus', function() {
                    if (this.value === '') {
                        this.removeAttribute('placeholder');
                    }
                });

                input.addEventListener('blur', function() {
                    if (this.value === '') {
                        const placeholderText = this.getAttribute('data-original-placeholder') || this.getAttribute('placeholder');
                        this.setAttribute('placeholder', placeholderText);
                    }
                });

                // Store original placeholder
                input.setAttribute('data-original-placeholder', input.getAttribute('placeholder'));
            });
        });

        function refreshAllImages() {
            console.log('Refreshing all images...');
            const images = document.querySelectorAll('img[src*="/images/users/"], img[src*="default-avatar"]');
            images.forEach(img => {
                const originalSrc = img.src.split('?')[0];
                img.src = originalSrc + '?v=' + Date.now();
            });

            // Also refresh the avatar in the header
            const headerAvatar = document.querySelector('.user-avatar');
            if (headerAvatar) {
                const headerSrc = headerAvatar.src.split('?')[0];
                headerAvatar.src = headerSrc + '?v=' + Date.now();
            }
        }
    </script>
}

<style>
    .profile-section {
        max-width: 800px;
    }

    .section-title {
        font-size: 1.5rem;
        font-weight: 700;
        color: #1f2937;
        margin-bottom: 1.5rem;
    }

    /* Beautiful status message */
    .status-message {
        padding: 1rem 1.5rem;
        border-radius: 0.75rem;
        margin-bottom: 1.5rem;
        font-weight: 500;
        display: flex;
        align-items: center;
        gap: 0.75rem;
        animation: slideIn 0.3s ease-out;
    }

        .status-message.success {
            background: #d1fae5;
            color: #065f46;
            border: 1px solid #a7f3d0;
        }

        .status-message.error {
            background: #fee2e2;
            color: #b91c1c;
            border: 1px solid #fecaca;
        }

        .status-message i {
            font-size: 1.25rem;
        }

    @@keyframes slideIn {
        from {
            opacity: 0;
            transform: translateY(-10px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    .form-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 1.5rem;
        margin-bottom: 2rem;
    }

    .form-group {
        display: flex;
        flex-direction: column;
    }

    .form-label {
        font-weight: 600;
        color: #374151;
        margin-bottom: 0.5rem;
    }

    .form-input {
        padding: 0.75rem 1rem;
        border: 1px solid #d1d5db;
        border-radius: 0.5rem;
        font-size: 1rem;
        transition: all 0.2s ease;
    }

        .form-input:focus {
            outline: none;
            border-color: #4f46e5;
            box-shadow: 0 0 0 3px rgba(79, 70, 229, 0.1);
        }

        .form-input:disabled {
            background-color: #f9fafb;
            color: #6b7280;
        }

        .form-input::placeholder {
            color: #9ca3af;
            font-style: italic;
        }

    .current-avatar {
        display: flex;
        justify-content: center;
        align-items: center;
        padding: 1rem 0;
        min-height: 150px;
    }

    .profile-avatar-preview {
        width: 150px;
        height: 150px;
        border-radius: 50%;
        object-fit: cover;
        border: 4px solid #e5e7eb;
    }

    .no-avatar-placeholder {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 0.5rem;
        color: #6b7280;
        padding: 2rem;
    }

        .no-avatar-placeholder i {
            font-size: 4rem;
            color: #d1d5db;
        }

        .no-avatar-placeholder span {
            font-size: 0.875rem;
        }

    /* File Upload */
    .file-upload-container {
        position: relative;
    }

    .file-input {
        position: absolute;
        left: -9999px;
    }

    .file-upload-label {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 0.5rem;
        padding: 1rem;
        border: 2px dashed #d1d5db;
        border-radius: 0.5rem;
        background: #f9fafb;
        color: #6b7280;
        cursor: pointer;
        transition: all 0.2s ease;
        text-align: center;
        flex-direction: column;
    }

        .file-upload-label:hover {
            border-color: #4f46e5;
            background: #f0f4ff;
            color: #4f46e5;
        }

    .submit-btn {
        background: #4f46e5;
        color: white;
        border: none;
        padding: 0.75rem 2rem;
        border-radius: 0.5rem;
        font-weight: 600;
        cursor: pointer;
        transition: all 0.2s ease;
        display: flex;
        align-items: center;
        gap: 0.5rem;
    }

        .submit-btn:hover:not(:disabled) {
            background: #4338ca;
        }

        .submit-btn:disabled {
            background: #9ca3af;
            cursor: not-allowed;
        }

    .text-danger {
        color: #ef4444;
        font-size: 0.875rem;
        margin-top: 0.25rem;
    }

    /* Responsive */
    @@media (max-width: 768px) {
        .form-grid {
            grid-template-columns: 1fr;
        }
    }
</style>