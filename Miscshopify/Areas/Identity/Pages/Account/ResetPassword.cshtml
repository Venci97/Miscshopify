@page
@model ResetPasswordModel
@{
    ViewData["Title"] = "Reset password";
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Reset Password - Modern Store</title>

    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
</head>
<body class="min-h-screen bg-gradient-to-br from-red-50 to-orange-100 flex items-center justify-center p-4" style="font-family: 'Inter', sans-serif;">
    <div class="max-w-md w-full">
        <div class="bg-white rounded-2xl shadow-xl p-8">
            <!-- Header -->
            <div class="text-center mb-8">
                <div class="w-16 h-16 bg-red-100 rounded-2xl flex items-center justify-center mx-auto mb-4">
                    <i class="fas fa-key text-red-600 text-2xl"></i>
                </div>
                <h1 class="text-3xl font-bold text-gray-900 mb-2">Reset Password</h1>
                <p class="text-gray-600">Create your new password</p>
            </div>

            <!-- Validation Summary -->
            <div asp-validation-summary="ModelOnly" class="mb-6 p-4 bg-red-50 border border-red-200 rounded-lg text-red-700"></div>

            <form method="post" class="space-y-6">
                <input asp-for="Input.Code" type="hidden" />

                <!-- Email Field -->
                <div class="space-y-2">
                    <label asp-for="Input.Email" class="block text-sm font-medium text-gray-700">
                        <i class="fas fa-envelope mr-2 text-red-500"></i>Email Address
                    </label>
                    <input asp-for="Input.Email"
                           autocomplete="username"
                           aria-required="true"
                           class="w-full px-4 py-3 border-2 border-gray-200 rounded-lg focus:outline-none focus:border-red-500 focus:ring-2 focus:ring-red-200 transition-all duration-300"
                           placeholder="Enter your email address" />
                    <span asp-validation-for="Input.Email" class="text-red-600 text-sm"></span>
                </div>

                <!-- Password Field -->
                <div class="space-y-2">
                    <label asp-for="Input.Password" class="block text-sm font-medium text-gray-700">
                        <i class="fas fa-lock mr-2 text-red-500"></i>New Password
                    </label>
                    <input asp-for="Input.Password"
                           autocomplete="new-password"
                           aria-required="true"
                           class="w-full px-4 py-3 border-2 border-gray-200 rounded-lg focus:outline-none focus:border-red-500 focus:ring-2 focus:ring-red-200 transition-all duration-300"
                           placeholder="Enter your new password" />
                    <span asp-validation-for="Input.Password" class="text-red-600 text-sm"></span>
                </div>

                <!-- Confirm Password Field -->
                <div class="space-y-2">
                    <label asp-for="Input.ConfirmPassword" class="block text-sm font-medium text-gray-700">
                        <i class="fas fa-lock mr-2 text-red-500"></i>Confirm New Password
                    </label>
                    <input asp-for="Input.ConfirmPassword"
                           autocomplete="new-password"
                           aria-required="true"
                           class="w-full px-4 py-3 border-2 border-gray-200 rounded-lg focus:outline-none focus:border-red-500 focus:ring-2 focus:ring-red-200 transition-all duration-300"
                           placeholder="Confirm your new password" />
                    <span asp-validation-for="Input.ConfirmPassword" class="text-red-600 text-sm"></span>
                </div>

                <!-- Password Requirements -->
                <div class="p-4 bg-gray-50 rounded-lg border border-gray-200">
                    <div class="flex items-start space-x-3">
                        <i class="fas fa-info-circle text-gray-500 mt-0.5"></i>
                        <div class="text-sm text-gray-700">
                            <p class="font-medium mb-1">Password Requirements</p>
                            <ul class="list-disc list-inside space-y-1">
                                <li>At least 6 characters long</li>
                                <li>Include uppercase and lowercase letters</li>
                                <li>Include at least one number</li>
                                <li>Include at least one special character</li>
                            </ul>
                        </div>
                    </div>
                </div>

                <!-- Reset Button -->
                <button type="submit"
                        class="w-full bg-gradient-to-r from-red-600 to-orange-600 text-white py-3 px-4 rounded-lg font-semibold text-lg hover:from-red-700 hover:to-orange-700 transform hover:-translate-y-0.5 transition-all duration-300 shadow-lg hover:shadow-xl">
                    <i class="fas fa-redo-alt mr-2"></i>Reset Password
                </button>
            </form>

            <!-- Navigation Links -->
            <div class="mt-6 flex flex-col sm:flex-row gap-3 justify-center">
                <a asp-page="./Login"
                   class="flex-1 border-2 border-gray-300 text-gray-700 py-2 px-4 rounded-lg font-medium hover:border-red-500 hover:text-red-600 hover:bg-red-50 transition-all duration-300 inline-flex items-center justify-center gap-2 text-center">
                    <i class="fas fa-arrow-left"></i>
                    Back to Login
                </a>
                <a href="/"
                   class="flex-1 border-2 border-gray-300 text-gray-700 py-2 px-4 rounded-lg font-medium hover:border-red-500 hover:text-red-600 hover:bg-red-50 transition-all duration-300 inline-flex items-center justify-center gap-2 text-center">
                    <i class="fas fa-home"></i>
                    Home
                </a>
            </div>

            <!-- Security Note -->
            <div class="mt-6 pt-6 border-t border-gray-200 text-center">
                <div class="flex items-center justify-center gap-2 text-xs text-gray-500">
                    <i class="fas fa-shield-alt"></i>
                    <span>Your password will be securely updated</span>
                </div>
            </div>
        </div>
    </div>

    <partial name="_ValidationScriptsPartial" />

    <style>
        .form-input {
            transition: all 0.3s ease;
        }

            .form-input:focus {
                transform: translateY(-2px);
                box-shadow: 0 10px 25px rgba(239, 68, 68, 0.1);
            }

        /* Animation for the key icon */
        @@keyframes shake {
            0%, 100% {
                transform: rotate(0deg);
            }

            25% {
                transform: rotate(-10deg);
            }

            75% {
                transform: rotate(10deg);
            }
        }

        .fa-key {
            animation: shake 3s ease-in-out infinite;
        }

        /* Password strength indicator animation */
        @@keyframes pulse-strong {
            0%, 100% {
                opacity: 1;
            }

            50% {
                opacity: 0.7;
            }
        }

        .password-strong {
            animation: pulse-strong 2s ease-in-out infinite;
        }
    </style>

    <script>
        document.addEventListener('DOMContentLoaded', function() {
            // Form submission feedback
            const form = document.querySelector('form');
            const submitButton = form.querySelector('button[type="submit"]');

            if (form && submitButton) {
                form.addEventListener('submit', function() {
                    submitButton.disabled = true;
                    submitButton.innerHTML = '<i class="fas fa-spinner fa-spin mr-2"></i>Resetting...';
                });
            }

            // Real-time password validation (optional enhancement)
            const passwordInput = document.querySelector('input[asp-for="Input.Password"]');
            const confirmPasswordInput = document.querySelector('input[asp-for="Input.ConfirmPassword"]');

            function validatePasswords() {
                if (passwordInput && confirmPasswordInput) {
                    if (passwordInput.value && confirmPasswordInput.value && passwordInput.value !== confirmPasswordInput.value) {
                        confirmPasswordInput.classList.add('border-red-500');
                    } else {
                        confirmPasswordInput.classList.remove('border-red-500');
                    }
                }
            }

            if (passwordInput && confirmPasswordInput) {
                passwordInput.addEventListener('input', validatePasswords);
                confirmPasswordInput.addEventListener('input', validatePasswords);
            }
        });
    </script>
</body>
</html>