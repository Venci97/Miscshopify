<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewData["Title"] - Miscshopify</title>

    <!-- Favicon -->
    <link rel="icon" href="~/img/Miscshopify_Logo" type="image/x-icon">
    <link rel="apple-touch-icon" sizes="180x180" href="~/img/apple-icon-180x180.png">
    <link rel="icon" type="image/png" sizes="32x32" href="~/img/favicon-32x32.png">
    <link rel="icon" type="image/png" sizes="16x16" href="~/img/favicon-16x16.png">

    <!-- Font Awesome -->
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet">

    <!-- Google Fonts -->
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&display=swap" rel="stylesheet">

    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>

    <!-- Custom CSS -->
    <link href="~/css/layout.css" rel="stylesheet" />

    @await RenderSectionAsync("Head", required: false)
</head>
<body class="layout-body">
    <!-- Header -->
    <header class="main-header">
        <nav class="nav-container">
            <!-- Logo and Brand -->
            <div class="nav-brand">
                <a href="/Home" class="brand-link">
                    <img src="~/img/Miscshopify_Logo_No_Traansperant.png" alt="Miscshopify" class="brand-logo">
                    <span class="brand-text">Miscshopify</span>
                </a>
            </div>

            <!-- Desktop Navigation -->
            <div class="desktop-nav">
                <a href="/Category/Index" class="nav-link">
                    <i class="fas fa-th-large mr-2"></i>
                    Categories
                </a>
                <a href="/Home/Contact" class="nav-link">
                    <i class="fas fa-envelope mr-2"></i>
                    Contact
                </a>

                @if (User.IsInRole("Administrator"))
                {
                    <a href="/Admin" class="nav-link admin-link">
                        <i class="fas fa-cog mr-2"></i>
                        Admin Panel
                    </a>
                }
            </div>

            <!-- Right Section - Search and User -->
            <div class="nav-right">
                <!-- Search Button -->
                <button class="search-btn" id="searchToggle">
                    <i class="fas fa-search"></i>
                </button>

                <!-- User Auth Partial -->
                <div class="auth-section">
                    <partial name="_LoginPartial" />
                </div>

                <!-- Mobile Menu Button -->
                <button class="mobile-menu-btn" id="mobileMenuToggle">
                    <i class="fas fa-bars"></i>
                </button>
            </div>
        </nav>

        <!-- Search Bar -->
        <div class="search-container hidden" id="searchContainer">
            <div class="search-box">
                <form action="@Url.Action("Results", "Search")" method="get" class="search-form">
                    <div class="search-input-group">
                        <i class="fas fa-search search-icon"></i>
                        <input type="text" name="searchTerm" placeholder="Search products, categories..." class="search-input">
                        <button type="submit" class="search-submit">
                            <i class="fas fa-arrow-right"></i>
                        </button>
                    </div>
                </form>
                <button class="search-close" id="searchClose">
                    <i class="fas fa-times"></i>
                </button>
            </div>
        </div>

        <!-- Mobile Navigation -->
        <div class="mobile-nav hidden" id="mobileNav">
            <div class="mobile-nav-content">
                <a href="/Home" class="mobile-nav-link">
                    <i class="fas fa-home mr-3"></i>
                    Home
                </a>
                <a href="/Category/Index" class="mobile-nav-link">
                    <i class="fas fa-th-large mr-3"></i>
                    Categories
                </a>
                <a href="/Cart/Index" class="mobile-nav-link">
                    <i class="fas fa-shopping-cart mr-3"></i>
                    Cart
                </a>
                <a href="/Home/Contact" class="mobile-nav-link">
                    <i class="fas fa-envelope mr-3"></i>
                    Contact
                </a>

                @if (User.IsInRole("Administrator"))
                {
                    <a href="/Admin" class="mobile-nav-link">
                        <i class="fas fa-cog mr-3"></i>
                        Admin Panel
                    </a>
                }

                <!-- Mobile Auth Section -->
                <div class="mobile-auth-section">
                    <partial name="_LoginPartial" />
                </div>
            </div>
        </div>
    </header>

    <!-- Main Content -->
    <main class="main-content">
        <!-- Page Header -->
        @if (!string.IsNullOrEmpty(ViewData["Title"]?.ToString()))
        {
            <div class="page-header">
                <div class="container">
                    <h1 class="page-title">@ViewData["Title"]</h1>
                </div>
            </div>
        }

        <!-- Content -->
        <div class="content-area">
            <div class="container">
                @RenderBody()
            </div>
        </div>
    </main>

    <!-- Footer -->
    <footer class="main-footer">
        <div class="container">
            <div class="footer-grid">
                <!-- Company Info -->
                <div class="footer-section">
                    <div class="footer-brand">
                        <img src="~/img/Miscshopify_Logo_No_Traansperant.png" alt="Miscshopify" class="footer-logo">
                        <span class="footer-brand-text">Miscshopify</span>
                    </div>
                    <p class="footer-description">
                        Your one-stop destination for all your shopping needs. Quality products, amazing prices.
                    </p>
                    <div class="contact-info">
                        <div class="contact-item">
                            <i class="fas fa-map-marker-alt"></i>
                            <span>123 Street, Sofia, Bulgaria</span>
                        </div>
                        <div class="contact-item">
                            <i class="fas fa-envelope"></i>
                            <span>info@miscshopify.com</span>
                        </div>
                        <div class="contact-item">
                            <i class="fas fa-phone-alt"></i>
                            <span>+359 123 456 789</span>
                        </div>
                    </div>
                </div>

                <!-- Quick Links -->
                <div class="footer-section">
                    <h3 class="footer-title">Quick Links</h3>
                    <div class="footer-links">
                        <a href="/Home" class="footer-link">
                            <i class="fas fa-chevron-right"></i>
                            Home
                        </a>
                        <a href="/Category/Index" class="footer-link">
                            <i class="fas fa-chevron-right"></i>
                            Categories
                        </a>
                        <a href="/Cart/Index" class="footer-link">
                            <i class="fas fa-chevron-right"></i>
                            Shopping Cart
                        </a>
                        <a href="/Home/Contact" class="footer-link">
                            <i class="fas fa-chevron-right"></i>
                            Contact Us
                        </a>
                    </div>
                </div>

                <!-- Customer Service -->
                <div class="footer-section">
                    <h3 class="footer-title">Customer Service</h3>
                    <div class="footer-links">
                        <a href="/Home/ShippingInfo" class="footer-link">
                            <i class="fas fa-chevron-right"></i>
                            Shipping Info
                        </a>
                        <a href="/Home/ReturnsRefunds" class="footer-link">
                            <i class="fas fa-chevron-right"></i>
                            Returns & Refunds
                        </a>
                        <a href="/Home/Privacy" class="footer-link">
                            <i class="fas fa-chevron-right"></i>
                            Privacy Policy
                        </a>
                        <a href="/Home/Terms" class="footer-link">
                            <i class="fas fa-chevron-right"></i>
                            Terms & Conditions
                        </a>
                    </div>
                </div>

                <!-- Newsletter -->
                <div class="footer-section">
                    <h3 class="footer-title">Newsletter</h3>
                    <p class="newsletter-text">Subscribe to get updates on new products and special offers.</p>
                    <form class="newsletter-form">
                        <div class="newsletter-input-group">
                            <input type="email" placeholder="Your email address" class="newsletter-input">
                            <button type="submit" class="newsletter-btn">
                                <i class="fas fa-paper-plane"></i>
                            </button>
                        </div>
                    </form>
                    <div class="social-links">
                        <a href="#" class="social-link">
                            <i class="fab fa-facebook-f"></i>
                        </a>
                        <a href="#" class="social-link">
                            <i class="fab fa-twitter"></i>
                        </a>
                        <a href="#" class="social-link">
                            <i class="fab fa-instagram"></i>
                        </a>
                        <a href="#" class="social-link">
                            <i class="fab fa-linkedin-in"></i>
                        </a>
                    </div>
                </div>
            </div>

            <!-- Footer Bottom -->
            <div class="footer-bottom">
                <div class="footer-bottom-content">
                    <p class="copyright">
                        &copy; 2024 Miscshopify. All rights reserved.
                    </p>
                    <div class="payment-methods">
                        <span class="payment-text">We accept:</span>
                        <div class="payment-icons">
                            <i class="fab fa-cc-visa payment-icon"></i>
                            <i class="fab fa-cc-mastercard payment-icon"></i>
                            <i class="fab fa-cc-paypal payment-icon"></i>
                            <i class="fab fa-cc-apple-pay payment-icon"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </footer>

    <!-- Scripts -->
    <script>
        // Mobile menu functionality
        document.addEventListener('DOMContentLoaded', function() {
            const mobileMenuToggle = document.getElementById('mobileMenuToggle');
            const mobileNav = document.getElementById('mobileNav');
            const searchToggle = document.getElementById('searchToggle');
            const searchContainer = document.getElementById('searchContainer');
            const searchClose = document.getElementById('searchClose');

            // Mobile menu toggle
            if (mobileMenuToggle) {
                mobileMenuToggle.addEventListener('click', function() {
                    mobileNav.classList.toggle('hidden');
                    document.body.classList.toggle('no-scroll');
                });
            }

            // Search toggle
            if (searchToggle) {
                searchToggle.addEventListener('click', function() {
                    searchContainer.classList.toggle('hidden');
                    if (!searchContainer.classList.contains('hidden')) {
                        document.querySelector('.search-input').focus();
                    }
                });
            }

            // Search close
            if (searchClose) {
                searchClose.addEventListener('click', function() {
                    searchContainer.classList.add('hidden');
                });
            }

            // Close mobile menu when clicking on a link
            document.querySelectorAll('.mobile-nav-link').forEach(link => {
                link.addEventListener('click', function() {
                    mobileNav.classList.add('hidden');
                    document.body.classList.remove('no-scroll');
                });
            });

            // Close search and mobile menu when clicking outside
            document.addEventListener('click', function(e) {
                if (!e.target.closest('.nav-right') && !e.target.closest('.mobile-nav')) {
                    mobileNav.classList.add('hidden');
                    document.body.classList.remove('no-scroll');
                }
                if (!e.target.closest('.search-container') && !e.target.closest('.search-btn')) {
                    searchContainer.classList.add('hidden');
                }
            });
        });

        // Add scroll effect to header
        window.addEventListener('scroll', function() {
            const header = document.querySelector('.main-header');
            if (window.scrollY > 50) {
                header.classList.add('scrolled');
            } else {
                header.classList.remove('scrolled');
            }
        });
    </script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>