@using System.Globalization
@{
    ViewData["Title"] = "Плащане";
    var totalPrice = ViewBag.TotalPrice;
    var paymentMethod = ViewBag.PaymentMethod;

    var priceForJs = Convert.ToDecimal(totalPrice).ToString(CultureInfo.InvariantCulture);
}

<!DOCTYPE html>
<html lang="bg">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Плащане - @ViewData["Title"]</title>

    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet">
    <script src="https://js.stripe.com/v3/"></script>
</head>
<body class="min-h-screen bg-gradient-to-br from-blue-50 to-blue-100 py-8">

    <form id="csrf-form" style="display:none">
        @Html.AntiForgeryToken()
    </form>

    <div class="container mx-auto px-4">
        <div class="max-w-md mx-auto bg-white rounded-2xl shadow-lg overflow-hidden">

            <!-- Header -->
            <div class="bg-blue-600 text-white p-6 text-center">
                <i class="fas fa-credit-card text-3xl mb-4"></i>
                <h1 class="text-2xl font-bold">Детайли за плащане</h1>
                <p class="opacity-90">@paymentMethod</p>
            </div>

            <!-- TempData Error Message -->
            @if (TempData["Error"] != null)
            {
                <div class="mx-6 mt-4 p-3 bg-red-50 border border-red-200 rounded-lg text-red-700 text-sm">
                    <i class="fas fa-exclamation-circle mr-2"></i>@TempData["Error"]
                </div>
            }

            <!-- Payment Form -->
            <div class="p-6">
                <div class="text-center mb-6">
                    <p class="text-gray-600">Сума за плащане</p>
                    <p class="text-3xl font-bold text-gray-800">@totalPrice BGN</p>
                </div>

                <div id="payment-form">
                    <!-- Stripe Payment Element Container -->
                    <div id="payment-element" class="mb-6">
                        <div class="flex items-center justify-center py-8 text-gray-400">
                            <i class="fas fa-spinner fa-spin mr-2"></i> Зареждане...
                        </div>
                    </div>

                    <!-- Stripe Errors -->
                    <div id="payment-errors" class="text-red-500 text-sm mb-4 hidden" role="alert">
                        <i class="fas fa-exclamation-circle mr-1"></i>
                        <span id="payment-error-message"></span>
                    </div>

                    <!-- Submit Button -->
                    <button id="submit-button"
                            class="w-full bg-blue-600 text-white py-4 px-6 rounded-lg font-bold text-lg hover:bg-blue-700 transition-colors flex items-center justify-center gap-2 disabled:opacity-50 disabled:cursor-not-allowed"
                            disabled>
                        <i class="fas fa-lock"></i>
                        Плати @totalPrice BGN
                    </button>
                </div>

                <p class="text-center text-gray-500 text-sm mt-4">
                    <i class="fas fa-shield-alt mr-1"></i>
                    Плащането е защитено и криптирано
                </p>
            </div>
        </div>
    </div>

    <script>
        // Configuration
        const PUBLISHABLE_KEY = '@ViewBag.PublishableKey';
        const TOTAL_PRICE = parseFloat('@priceForJs');
        const PAYMENT_METHOD = '@paymentMethod';

        function getAntiForgeryToken() {
        const input = document.querySelector('input[name="__RequestVerificationToken"]');
        return input ? input.value : '';
        }

        if (!PUBLISHABLE_KEY) {
        showError('Грешка: Липсва Stripe Publishable Key от сървъра.');
        }

        const stripe = Stripe(PUBLISHABLE_KEY);
        let elements;
        let paymentElement;

        // Step 1: Initialize Stripe
        async function initialize() {
        try {
        const token = getAntiForgeryToken();

        const response = await fetch('/Payment/CreatePaymentIntent', {
        method: 'POST',
        headers: {
        'Content-Type': 'application/json',
        'RequestVerificationToken': token
        },
        body: JSON.stringify({
        amount: TOTAL_PRICE,
        paymentMethod: PAYMENT_METHOD
        })
        });

        if (!response.ok) {
        const errText = await response.text();
        console.error('Server returned error status:', response.status, errText);
        showError(`Сървърна грешка (${response.status}). Моля, опитайте по-късно.`);
        return;
        }

        const data = await response.json();

        if (data.error) {
        showError(data.error);
        return;
        }

        if (!data.clientSecret) {
        showError('Липсва clientSecret от сървъра.');
        return;
        }

        elements = stripe.elements({ clientSecret: data.clientSecret });

        paymentElement = elements.create('payment', {
        layout: 'tabs'
        });
        paymentElement.mount('#payment-element');

        paymentElement.on('ready', () => {
        document.getElementById('submit-button').disabled = false;
        });

        paymentElement.on('change', (event) => {
        if (event.error) {
        showError(event.error.message);
        } else {
        hideError();
        }
        });

        } catch (err) {
        console.error('Initialization error:', err);
        showError('Грешка при зареждане на платежната форма. Опреснете страницата.');
        }
        }

        // Step 2: Confirm Payment
        document.getElementById('submit-button').addEventListener('click', async () => {
        const submitButton = document.getElementById('submit-button');
        submitButton.disabled = true;
        submitButton.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Обработва се...';
        hideError();

        try {
        const { paymentIntent, error } = await stripe.confirmPayment({
        elements,
        redirect: 'if_required'
        });

        if (error) {
        showError(error.message);
        submitButton.disabled = false;
        submitButton.innerHTML = '<i class="fas fa-lock"></i> Плати @totalPrice BGN';
        return;
        }

        if (paymentIntent.status === 'succeeded') {
        // Step 3: Confirm order on the server
        const confirmResponse = await fetch('/Payment/ConfirmOrder', {
        method: 'POST',
        headers: {
        'Content-Type': 'application/json',
        'RequestVerificationToken': getAntiForgeryToken()
        },
        body: JSON.stringify({
        paymentIntentId: paymentIntent.id,
        amount: TOTAL_PRICE,
        paymentMethod: PAYMENT_METHOD
        })
        });

        const confirmData = await confirmResponse.json();

        if (confirmData.success) {
        window.location.href = confirmData.redirectUrl;
        } else {
        showError(confirmData.error ?? 'Грешка при записване на поръчката.');
        submitButton.disabled = false;
        submitButton.innerHTML = '<i class="fas fa-lock"></i> Плати @totalPrice BGN';
        }
        } else {
        showError(`Неочакван статус на плащането: ${paymentIntent.status}`);
        submitButton.disabled = false;
        submitButton.innerHTML = '<i class="fas fa-lock"></i> Плати @totalPrice BGN';
        }

        } catch (err) {
        console.error('Payment error:', err);
        showError('Възникна неочаквана грешка. Опитайте отново.');
        submitButton.disabled = false;
        submitButton.innerHTML = '<i class="fas fa-lock"></i> Плати @totalPrice BGN';
        }
        });

        // Helpers
        function showError(message) {
        const errorDiv = document.getElementById('payment-errors');
        document.getElementById('payment-error-message').textContent = message;
        errorDiv.classList.remove('hidden');
        }

        function hideError() {
        document.getElementById('payment-errors').classList.add('hidden');
        }

        initialize();
    </script>
</body>
</html>