@using Miscshopify.Core.Models;
@using Miscshopify.Infrastructure.Data.Models.Enums;
@model IEnumerable<OrderViewModel>

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>My Orders - Modern Store</title>

    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <link href="~/css/my-orders.css" rel="stylesheet" />
</head>
<body class="my-orders-page min-h-screen py-8">
    <div class="container mx-auto px-4">
        <!-- Header -->
        <div class="orders-header text-center mb-12">
            <h1 class="text-4xl md:text-5xl font-bold text-gray-800 mb-4">
                My Orders
            </h1>
            <p class="text-xl text-gray-600">
                Track and manage your orders
            </p>
        </div>

        <!-- Orders Content -->
        <div class="max-w-6xl mx-auto">
            @if (Model != null && Model.Any())
            {
                <!-- Orders Table -->
                <div class="orders-table-container bg-white rounded-2xl shadow-lg overflow-hidden">
                    <div class="overflow-x-auto">
                        <table class="w-full">
                            <thead>
                                <tr class="bg-gray-50 border-b border-gray-200">
                                    <th class="py-4 px-6 text-left font-semibold text-gray-700">Order Details</th>
                                    <th class="py-4 px-6 text-left font-semibold text-gray-700">Status</th>
                                    <th class="py-4 px-6 text-left font-semibold text-gray-700">Payment Method</th>
                                    <th class="py-4 px-6 text-center font-semibold text-gray-700">Actions</th>
                                </tr>
                            </thead>
                            <tbody class="divide-y divide-gray-100">
                                @foreach (var order in Model)
                                {
                                    <tr class="order-row hover:bg-gray-50 transition-colors duration-200">
                                        <td class="py-6 px-6">
                                            <div class="order-info">
                                                <div class="flex items-center gap-3 mb-2">
                                                    <div class="order-icon">
                                                        <i class="fas fa-receipt text-indigo-500"></i>
                                                    </div>
                                                    <div>
                                                        <h3 class="font-semibold text-gray-800">@order.CustomerName</h3>
                                                        <p class="text-sm text-gray-500">Order #@order.Id.ToString().Substring(0, 8)</p>
                                                    </div>
                                                </div>
                                            </div>
                                        </td>
                                        <td class="py-6 px-6">
                                            <div class="status-badge @GetStatusClass(order.Status)">
                                                <span class="status-dot"></span>
                                                @order.Status
                                            </div>
                                        </td>
                                        <td class="py-6 px-6">
                                            <div class="payment-method">
                                                <div class="flex items-center gap-2">
                                                    <i class="fas @GetPaymentIcon(order.PaymentMethod) text-gray-500"></i>
                                                    <span class="text-gray-700">@order.PaymentMethod</span>
                                                </div>
                                            </div>
                                        </td>
                                        <td class="py-6 px-6">
                                            <div class="flex justify-center">
                                                <a asp-action="OrderDetails" asp-controller="Order" asp-route-id="@order.Id"
                                                   class="details-btn bg-indigo-600 text-white px-6 py-2 rounded-lg font-semibold hover:bg-indigo-700 transition-all duration-300 transform hover:scale-105">
                                                    <i class="fas fa-eye mr-2"></i>
                                                    View Details
                                                </a>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>

                <!-- Orders Summary -->
                <div class="orders-summary mt-8 grid grid-cols-1 md:grid-cols-3 gap-6">
                    <div class="summary-card">
                        <div class="summary-icon pending">
                            <i class="fas fa-clock"></i>
                        </div>
                        <div class="summary-content">
                            <h3 class="summary-count">@Model.Count(o => o.Status.ToString() == "Pending")</h3>
                            <p class="summary-label">Pending Orders</p>
                        </div>
                    </div>
                    <div class="summary-card">
                        <div class="summary-icon processing">
                            <i class="fas fa-shipping-fast"></i>
                        </div>
                        <div class="summary-content">
                            <h3 class="summary-count">@Model.Count(o => o.Status.ToString() == "OnTheWay")</h3>
                            <p class="summary-label">On The Way</p>
                        </div>
                    </div>
                    <div class="summary-card">
                        <div class="summary-icon completed">
                            <i class="fas fa-check-circle"></i>
                        </div>
                        <div class="summary-content">
                            <h3 class="summary-count">@Model.Count(o => o.Status.ToString() == "Completed")</h3>
                            <p class="summary-label">Completed</p>
                        </div>
                    </div>
                </div>
            }
            else
            {
                <!-- Empty State -->
                <div class="empty-orders text-center py-16">
                    <div class="empty-icon mb-6">
                        <i class="fas fa-shopping-bag text-6xl text-gray-300"></i>
                    </div>
                    <h3 class="text-2xl font-bold text-gray-800 mb-4">No Orders Yet</h3>
                    <p class="text-gray-600 mb-8 max-w-md mx-auto">
                        You haven't placed any orders yet. Start shopping to see your orders here!
                    </p>
                    <a href="/Category/Index"
                       class="inline-flex items-center gap-2 bg-indigo-600 text-white px-8 py-3 rounded-lg font-semibold hover:bg-indigo-700 transition-all duration-300 transform hover:scale-105">
                        <i class="fas fa-shopping-bag"></i>
                        Start Shopping
                    </a>
                </div>
            }
        </div>
    </div>

    @functions {
        public string GetStatusClass(Miscshopify.Infrastructure.Data.Models.Enums.OrderStatusEnum status)
        {
            return status.ToString() switch
            {
                "Pending" => "status-pending",
                "OnTheWay" => "status-processing",
                "Completed" => "status-completed",
                _ => "status-pending"
            };
        }

        public string GetPaymentIcon(Miscshopify.Infrastructure.Data.Models.Enums.PaymentMethodEnum paymentMethod)
        {
            return paymentMethod.ToString() switch
            {
                "Card" => "fa-credit-card",
                "CashOnDelivery" => "fa-money-bill-wave",
                _ => "fa-credit-card"
            };
        }
    }

    <script>
        document.addEventListener('DOMContentLoaded', function() {
            // Add animation to order rows
            const orderRows = document.querySelectorAll('.order-row');
            orderRows.forEach((row, index) => {
                row.style.animationDelay = `${index * 0.1}s`;
                row.classList.add('animate-in');
            });
        });
    </script>
</body>
</html>