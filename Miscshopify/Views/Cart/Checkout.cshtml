@using Microsoft.AspNetCore.Identity
@using Miscshopify.Core.Models
@using System.Security.Claims
@using Miscshopify.Infrastructure.Data.Models
@using System.Globalization
@model CheckoutViewModel

@{
    ViewData["Title"] = "Checkout";

    // Format the total price to use a dot (.) instead of a comma (,) for JavaScript compatibility
    var priceForJs = Model.TotalPrice.ToString(CultureInfo.InvariantCulture);
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Checkout - Modern Store</title>

    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <link href="~/css/checkout.css" rel="stylesheet" />
</head>
<body class="checkout-page min-h-screen py-8">

    <!-- AntiForgery Token Form -->
    <form id="csrf-form" style="display:none">
        @Html.AntiForgeryToken()
    </form>

    <div class="container mx-auto px-4">
        <div class="checkout-container p-6">
            <!-- Header -->
            <div class="text-center mb-8">
                <h1 class="text-4xl md:text-5xl font-bold text-gray-800 mb-4">
                    Checkout
                </h1>
                <p class="text-xl text-gray-600">
                    Complete your order
                </p>
            </div>

            <div class="flex flex-col lg:flex-row gap-8">
                <!-- Order Summary -->
                <div class="lg:w-1/2">
                    <div class="order-summary">
                        <h2 class="text-2xl font-bold mb-4">Order Summary</h2>
                        <div class="space-y-4">
                            @foreach (var item in Model.Items)
                            {
                                <div class="flex items-center gap-4 p-4 bg-white rounded-lg shadow-sm">
                                    <img src="~/@item.ImagePath" alt="@item.ProductName"
                                         class="w-16 h-16 object-cover rounded-lg"
                                         onerror="this.src='https://images.unsplash.com/photo-1560769629-975ec94e6a86?ixlib=rb-4.0.3&auto=format&fit=crop&w=100&q=80'">
                                    <div class="flex-1">
                                        <h3 class="font-semibold">@item.ProductName</h3>
                                        <p class="text-gray-600">Quantity: @item.Quantity</p>
                                    </div>
                                    <div class="text-right">
                                        <p class="font-bold">@(item.Price * item.Quantity) BGN</p>
                                    </div>
                                </div>
                            }
                        </div>

                        <div class="mt-6 p-4 bg-gray-50 rounded-lg">
                            <div class="flex justify-between mb-2">
                                <span>Items (@Model.TotalQuantity)</span>
                                <span>@Model.TotalPrice BGN</span>
                            </div>
                            <div class="flex justify-between mb-2">
                                <span>Shipping</span>
                                <span>0.00 BGN</span>
                            </div>
                            <div class="flex justify-between font-bold text-lg">
                                <span>Total</span>
                                <span>@Model.TotalPrice BGN</span>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Shipping and Payment Information -->
                <div class="lg:w-1/2">
                    <div class="checkout-form">
                        <h2 class="text-2xl font-bold mb-4">Shipping Information</h2>

                        <div class="bg-white p-6 rounded-lg shadow-sm mb-6">
                            <div class="mb-4">
                                <label class="block text-gray-700 font-medium mb-2">Full Name</label>
                                <p class="text-gray-900">@Model.UserName</p>
                            </div>
                            <div class="mb-4">
                                <label class="block text-gray-700 font-medium mb-2">Email</label>
                                <p class="text-gray-900">@Model.UserEmail</p>
                            </div>
                            <div class="mb-4">
                                <label class="block text-gray-700 font-medium mb-2">Phone</label>
                                <p class="text-gray-900">@Model.UserPhoneNumber</p>
                            </div>
                            <div class="mb-4">
                                <label class="block text-gray-700 font-medium mb-2">Address</label>
                                <p class="text-gray-900">@Model.UserAddress, @Model.UserCity, @Model.UserPostCode</p>
                            </div>
                        </div>

                        <h2 class="text-2xl font-bold mb-4">Payment Method</h2>
                        <div class="bg-white p-6 rounded-lg shadow-sm">
                            <div class="mb-4">
                                <label class="flex items-center cursor-pointer">
                                    <input type="radio" name="paymentMethod" value="cashOnDelivery" checked class="mr-2">
                                    <i class="fa-solid fa-money-bill-1 mr-2"></i>
                                    <span>Cash on Delivery</span>
                                </label>
                            </div>
                            <div class="mb-4">
                                <label class="flex items-center cursor-pointer">
                                    <input type="radio" name="paymentMethod" value="Card" class="mr-2">
                                    <i class="fa-solid fa-credit-card mr-2"></i>
                                    <span>Credit/Debit Card</span>
                                </label>
                            </div>
                        </div>

                        <button id="confirmButton" type="button" class="w-full bg-green-600 text-white py-4 px-6 rounded-lg font-bold text-lg mt-6 hover:bg-green-700 transition-colors">
                            Confirm Order
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <script>
        document.getElementById('confirmButton').addEventListener('click', function () {
        var selectedPayment = document.querySelector('input[name="paymentMethod"]:checked');

        if (!selectedPayment) {
        alert('Please select a payment method');
        return;
        }

        var paymentMethod = selectedPayment.value;
        var totalPrice = '@priceForJs';

        if (paymentMethod === 'cashOnDelivery') {
        // Create a dynamic POST form to avoid HTTP 405 error
        var form = document.createElement('form');
        form.method = 'POST';
        form.action = '@Url.Action("CompleteOrder", "Order")';

        var paymentInput = document.createElement('input');
        paymentInput.type = 'hidden';
        paymentInput.name = 'paymentMethod';
        paymentInput.value = paymentMethod;
        form.appendChild(paymentInput);

        var tokenInput = document.createElement('input');
        tokenInput.type = 'hidden';
        tokenInput.name = '__RequestVerificationToken';
        tokenInput.value = document.querySelector('input[name="__RequestVerificationToken"]')?.value || '';
        form.appendChild(tokenInput);

        document.body.appendChild(form);
        form.submit();
        } else if (paymentMethod === 'Card') {
        var paymentUrl = '@Url.Action("CreatePayment", "Payment")' + '?totalPrice=' + encodeURIComponent(totalPrice) + '&paymentMethod=' + encodeURIComponent(paymentMethod);
        window.location.href = paymentUrl;
        }
        });
    </script>
</body>
</html>