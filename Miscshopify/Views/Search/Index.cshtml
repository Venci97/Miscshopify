@{
    ViewData["Title"] = "Search";
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Search - Modern Store</title>

    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <link href="~/css/privacy.css" rel="stylesheet" />
</head>
<body class="min-h-screen bg-gradient-to-br from-purple-50 to-pink-100" style="font-family: 'Inter', sans-serif;">
    <div class="container mx-auto px-4 py-8">
        <!-- Header -->
        <div class="text-center mb-12">
            <div class="w-20 h-20 bg-purple-100 rounded-2xl flex items-center justify-center mx-auto mb-6">
                <i class="fas fa-search text-purple-600 text-3xl"></i>
            </div>
            <h1 class="text-4xl md:text-5xl font-bold text-gray-900 mb-4">Discover Products</h1>
            <p class="text-xl text-gray-600 max-w-2xl mx-auto">
                Find exactly what you're looking for in our extensive collection
            </p>
        </div>

        <!-- Search Form -->
        <div class="max-w-2xl mx-auto">
            <div class="bg-white rounded-2xl shadow-xl p-8">
                <!-- Search Form -->
                <!-- ПРОМЯНА ТУК: method="get" вместо method="post" -->
                <form method="get" action="@Url.Action("Results", "Search")" class="space-y-6">
                    <!-- Search Input -->
                    <div class="relative">
                        <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
                            <i class="fas fa-search text-gray-400"></i>
                        </div>
                        <input type="text"
                               name="searchTerm"
                               class="w-full pl-10 pr-4 py-4 border-2 border-gray-200 rounded-xl focus:outline-none focus:border-purple-500 focus:ring-2 focus:ring-purple-200 transition-all duration-300 text-lg"
                               placeholder="What are you looking for today?"
                               autocomplete="off"
                               autofocus>
                    </div>

                    <!-- Search Filters (Optional) -->
                    <div class="bg-gray-50 p-4 rounded-lg border border-gray-200">
                        <h3 class="font-semibold text-gray-700 mb-3 flex items-center gap-2">
                            <i class="fas fa-filter text-purple-500"></i>
                            Refine Your Search
                        </h3>
                        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                            <div>
                                <label class="block text-sm font-medium text-gray-700 mb-2">Category</label>
                                <select class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-1 focus:ring-purple-500 focus:border-purple-500">
                                    <option value="">All Categories</option>
                                    <option value="electronics">Electronics</option>
                                    <option value="clothing">Clothing</option>
                                    <option value="home">Home & Garden</option>
                                    <option value="sports">Sports</option>
                                </select>
                            </div>
                            <div>
                                <label class="block text-sm font-medium text-gray-700 mb-2">Price Range</label>
                                <select class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-1 focus:ring-purple-500 focus:border-purple-500">
                                    <option value="">Any Price</option>
                                    <option value="0-50">Under 50 BGN</option>
                                    <option value="50-100">50 - 100 BGN</option>
                                    <option value="100-200">100 - 200 BGN</option>
                                    <option value="200+">Over 200 BGN</option>
                                </select>
                            </div>
                        </div>
                    </div>

                    <!-- Search Button -->
                    <button type="submit"
                            class="w-full bg-gradient-to-r from-purple-600 to-pink-600 text-white py-4 px-6 rounded-xl font-semibold text-lg hover:from-purple-700 hover:to-pink-700 transform hover:-translate-y-1 transition-all duration-300 shadow-lg hover:shadow-xl flex items-center justify-center gap-3">
                        <i class="fas fa-search"></i>
                        Search Products
                    </button>
                </form>

                <!-- Popular Searches -->
                <div class="mt-8 pt-6 border-t border-gray-200">
                    <h3 class="font-semibold text-gray-700 mb-4 flex items-center gap-2">
                        <i class="fas fa-fire text-orange-500"></i>
                        Popular Searches
                    </h3>
                    <div class="flex flex-wrap gap-2">
                        <a href="@Url.Action("Results", "Search", new { searchTerm = "smartphone" })"
                           class="inline-flex items-center gap-1 px-3 py-2 bg-gray-100 text-gray-700 rounded-full text-sm hover:bg-purple-100 hover:text-purple-700 transition-colors">
                            <i class="fas fa-mobile-alt text-xs"></i>
                            Smartphones
                        </a>
                        <a href="@Url.Action("Results", "Search", new { searchTerm = "laptop" })"
                           class="inline-flex items-center gap-1 px-3 py-2 bg-gray-100 text-gray-700 rounded-full text-sm hover:bg-purple-100 hover:text-purple-700 transition-colors">
                            <i class="fas fa-laptop text-xs"></i>
                            Laptops
                        </a>
                        <a href="@Url.Action("Results", "Search", new { searchTerm = "headphones" })"
                           class="inline-flex items-center gap-1 px-3 py-2 bg-gray-100 text-gray-700 rounded-full text-sm hover:bg-purple-100 hover:text-purple-700 transition-colors">
                            <i class="fas fa-headphones text-xs"></i>
                            Headphones
                        </a>
                        <a href="@Url.Action("Results", "Search", new { searchTerm = "watch" })"
                           class="inline-flex items-center gap-1 px-3 py-2 bg-gray-100 text-gray-700 rounded-full text-sm hover:bg-purple-100 hover:text-purple-700 transition-colors">
                            <i class="fas fa-clock text-xs"></i>
                            Watches
                        </a>
                        <a href="@Url.Action("Results", "Search", new { searchTerm = "shoes" })"
                           class="inline-flex items-center gap-1 px-3 py-2 bg-gray-100 text-gray-700 rounded-full text-sm hover:bg-purple-100 hover:text-purple-700 transition-colors">
                            <i class="fas fa-shoe-prints text-xs"></i>
                            Shoes
                        </a>
                    </div>
                </div>
            </div>

            <!-- Features -->
            <div class="mt-8 grid md:grid-cols-3 gap-6">
                <div class="text-center p-6 bg-white rounded-xl shadow-lg">
                    <div class="w-12 h-12 bg-blue-100 rounded-xl flex items-center justify-center mx-auto mb-4">
                        <i class="fas fa-shipping-fast text-blue-600"></i>
                    </div>
                    <h3 class="font-semibold text-gray-800 mb-2">Fast Delivery</h3>
                    <p class="text-gray-600 text-sm">Free shipping on orders over 100 BGN</p>
                </div>
                <div class="text-center p-6 bg-white rounded-xl shadow-lg">
                    <div class="w-12 h-12 bg-green-100 rounded-xl flex items-center justify-center mx-auto mb-4">
                        <i class="fas fa-shield-alt text-green-600"></i>
                    </div>
                    <h3 class="font-semibold text-gray-800 mb-2">Secure Shopping</h3>
                    <p class="text-gray-600 text-sm">Your data is protected and secure</p>
                </div>
                <div class="text-center p-6 bg-white rounded-xl shadow-lg">
                    <div class="w-12 h-12 bg-purple-100 rounded-xl flex items-center justify-center mx-auto mb-4">
                        <i class="fas fa-headset text-purple-600"></i>
                    </div>
                    <h3 class="font-semibold text-gray-800 mb-2">24/7 Support</h3>
                    <p class="text-gray-600 text-sm">We're here to help you anytime</p>
                </div>
            </div>

            <!-- Navigation -->
            <div class="mt-8 text-center">
                <a href="/"
                   class="inline-flex items-center gap-2 text-purple-600 hover:text-purple-700 font-semibold transition-colors">
                    <i class="fas fa-arrow-left"></i>
                    Back to Homepage
                </a>
            </div>
        </div>
    </div>

    <script>
        document.addEventListener('DOMContentLoaded', function() {
            // Auto-focus on search input
            const searchInput = document.querySelector('input[name="searchTerm"]');
            if (searchInput) {
                searchInput.focus();
            }

            // Add search suggestions (basic example)
            const popularSearches = ['smartphone', 'laptop', 'headphones', 'watch', 'shoes', 'jacket', 'camera', 'books'];
            const searchInputField = document.querySelector('input[name="searchTerm"]');
            let suggestionsDiv;

            searchInputField.addEventListener('input', function() {
                const value = this.value.toLowerCase();

                // Remove existing suggestions
                if (suggestionsDiv) {
                    suggestionsDiv.remove();
                }

                if (value.length > 1) {
                    const matches = popularSearches.filter(item =>
                        item.toLowerCase().includes(value)
                    );

                    if (matches.length > 0) {
                        suggestionsDiv = document.createElement('div');
                        suggestionsDiv.className = 'absolute z-10 w-full bg-white border border-gray-200 rounded-lg mt-1 shadow-lg';

                        matches.forEach(match => {
                            const suggestion = document.createElement('div');
                            suggestion.className = 'px-4 py-2 hover:bg-purple-50 cursor-pointer flex items-center gap-2';
                            suggestion.innerHTML = `<i class="fas fa-search text-gray-400 text-xs"></i> ${match}`;
                            suggestion.addEventListener('click', function() {
                                searchInputField.value = match;
                                suggestionsDiv.remove();
                                searchInputField.focus();
                            });
                            suggestionsDiv.appendChild(suggestion);
                        });

                        this.parentNode.appendChild(suggestionsDiv);
                    }
                }
            });

            // Close suggestions when clicking outside
            document.addEventListener('click', function(e) {
                if (suggestionsDiv && !searchInputField.contains(e.target) && !suggestionsDiv.contains(e.target)) {
                    suggestionsDiv.remove();
                }
            });
        });
    </script>
</body>
</html>