@{
    ViewData["Title"] = "Privacy Policy";
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Privacy Policy - Modern Store</title>

    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <link href="~/css/privacy.css" rel="stylesheet" />
</head>
<body class="min-h-screen bg-gradient-to-br from-blue-50 to-indigo-100" style="font-family: 'Inter', sans-serif;">
    <div class="container mx-auto px-4 py-8">
        <!-- Header -->
        <div class="text-center mb-12">
            <div class="w-20 h-20 bg-blue-100 rounded-2xl flex items-center justify-center mx-auto mb-6">
                <i class="fas fa-shield-alt text-blue-600 text-3xl"></i>
            </div>
            <h1 class="text-4xl md:text-5xl font-bold text-gray-900 mb-4">Privacy Policy</h1>
            <p class="text-xl text-gray-600 max-w-2xl mx-auto">
                Your privacy is important to us. Learn how we protect and manage your personal information.
            </p>
        </div>

        <!-- Main Content -->
        <div class="max-w-4xl mx-auto">
            <div class="bg-white rounded-2xl shadow-xl p-8">
                <!-- Last Updated -->
                <div class="mb-8 p-4 bg-blue-50 border border-blue-200 rounded-lg">
                    <div class="flex items-center space-x-3">
                        <i class="fas fa-clock text-blue-500"></i>
                        <div>
                            <p class="font-medium text-blue-800">Last Updated</p>
                            <p class="text-blue-600">@DateTime.Now.ToString("MMMM dd, yyyy")</p>
                        </div>
                    </div>
                </div>

                <!-- Privacy Policy Content -->
                <div class="prose prose-lg max-w-none">
                    <!-- Introduction -->
                    <div class="mb-8">
                        <h2 class="text-2xl font-bold text-gray-900 mb-4 flex items-center gap-3">
                            <i class="fas fa-info-circle text-blue-500"></i>
                            Introduction
                        </h2>
                        <p class="text-gray-700 leading-relaxed">
                            At Modern Store, we are committed to protecting your privacy and ensuring the security of your personal information.
                            This Privacy Policy explains how we collect, use, disclose, and safeguard your information when you use our website and services.
                        </p>
                    </div>

                    <!-- Information We Collect -->
                    <div class="mb-8">
                        <h2 class="text-2xl font-bold text-gray-900 mb-4 flex items-center gap-3">
                            <i class="fas fa-database text-blue-500"></i>
                            Information We Collect
                        </h2>
                        <div class="grid md:grid-cols-2 gap-6 mb-4">
                            <div class="p-4 bg-gray-50 rounded-lg">
                                <h3 class="font-semibold text-gray-800 mb-2 flex items-center gap-2">
                                    <i class="fas fa-user text-green-500"></i>
                                    Personal Information
                                </h3>
                                <ul class="text-gray-700 space-y-1 text-sm">
                                    <li>• Name and contact details</li>
                                    <li>• Email address</li>
                                    <li>• Shipping and billing address</li>
                                    <li>• Payment information</li>
                                </ul>
                            </div>
                            <div class="p-4 bg-gray-50 rounded-lg">
                                <h3 class="font-semibold text-gray-800 mb-2 flex items-center gap-2">
                                    <i class="fas fa-chart-line text-purple-500"></i>
                                    Usage Data
                                </h3>
                                <ul class="text-gray-700 space-y-1 text-sm">
                                    <li>• Browser type and version</li>
                                    <li>• Pages visited and time spent</li>
                                    <li>• IP address and device information</li>
                                    <li>• Shopping preferences</li>
                                </ul>
                            </div>
                        </div>
                    </div>

                    <!-- How We Use Your Information -->
                    <div class="mb-8">
                        <h2 class="text-2xl font-bold text-gray-900 mb-4 flex items-center gap-3">
                            <i class="fas fa-cogs text-blue-500"></i>
                            How We Use Your Information
                        </h2>
                        <div class="space-y-4">
                            <div class="flex items-start space-x-3 p-4 bg-green-50 rounded-lg">
                                <i class="fas fa-shopping-cart text-green-500 mt-1"></i>
                                <div>
                                    <h3 class="font-semibold text-green-800">Order Processing</h3>
                                    <p class="text-green-700 text-sm">To process and fulfill your orders and deliver products</p>
                                </div>
                            </div>
                            <div class="flex items-start space-x-3 p-4 bg-blue-50 rounded-lg">
                                <i class="fas fa-comments text-blue-500 mt-1"></i>
                                <div>
                                    <h3 class="font-semibold text-blue-800">Customer Support</h3>
                                    <p class="text-blue-700 text-sm">To provide customer service and support</p>
                                </div>
                            </div>
                            <div class="flex items-start space-x-3 p-4 bg-purple-50 rounded-lg">
                                <i class="fas fa-chart-bar text-purple-500 mt-1"></i>
                                <div>
                                    <h3 class="font-semibold text-purple-800">Improve Services</h3>
                                    <p class="text-purple-700 text-sm">To enhance and personalize your shopping experience</p>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Data Protection -->
                    <div class="mb-8">
                        <h2 class="text-2xl font-bold text-gray-900 mb-4 flex items-center gap-3">
                            <i class="fas fa-lock text-blue-500"></i>
                            Data Protection
                        </h2>
                        <div class="p-4 bg-yellow-50 border border-yellow-200 rounded-lg">
                            <div class="flex items-start space-x-3">
                                <i class="fas fa-shield-alt text-yellow-500 mt-0.5"></i>
                                <div class="text-yellow-800">
                                    <p class="font-medium mb-2">We implement appropriate security measures</p>
                                    <p class="text-sm">Your data is protected through encryption, secure servers, and regular security audits. We never sell your personal information to third parties.</p>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Your Rights -->
                    <div class="mb-8">
                        <h2 class="text-2xl font-bold text-gray-900 mb-4 flex items-center gap-3">
                            <i class="fas fa-user-check text-blue-500"></i>
                            Your Rights
                        </h2>
                        <div class="grid md:grid-cols-2 gap-4">
                            <div class="p-4 border border-gray-200 rounded-lg">
                                <i class="fas fa-eye text-blue-500 text-lg mb-2"></i>
                                <h3 class="font-semibold text-gray-800 mb-2">Right to Access</h3>
                                <p class="text-gray-700 text-sm">You can request access to your personal data</p>
                            </div>
                            <div class="p-4 border border-gray-200 rounded-lg">
                                <i class="fas fa-edit text-green-500 text-lg mb-2"></i>
                                <h3 class="font-semibold text-gray-800 mb-2">Right to Rectify</h3>
                                <p class="text-gray-700 text-sm">You can update or correct your information</p>
                            </div>
                            <div class="p-4 border border-gray-200 rounded-lg">
                                <i class="fas fa-trash-alt text-red-500 text-lg mb-2"></i>
                                <h3 class="font-semibold text-gray-800 mb-2">Right to Delete</h3>
                                <p class="text-gray-700 text-sm">You can request deletion of your data</p>
                            </div>
                            <div class="p-4 border border-gray-200 rounded-lg">
                                <i class="fas fa-ban text-orange-500 text-lg mb-2"></i>
                                <h3 class="font-semibold text-gray-800 mb-2">Right to Object</h3>
                                <p class="text-gray-700 text-sm">You can object to certain data processing</p>
                            </div>
                        </div>
                    </div>

                    <!-- Contact Information -->
                    <div class="p-6 bg-gray-50 rounded-lg border border-gray-200">
                        <h2 class="text-2xl font-bold text-gray-900 mb-4 flex items-center gap-3">
                            <i class="fas fa-envelope text-blue-500"></i>
                            Contact Us
                        </h2>
                        <p class="text-gray-700 mb-4">
                            If you have any questions about this Privacy Policy or your personal data, please contact us:
                        </p>
                        <div class="space-y-2">
                            <div class="flex items-center space-x-3 text-gray-700">
                                <i class="fas fa-envelope text-blue-500"></i>
                                <span>privacy@modernstore.com</span>
                            </div>
                            <div class="flex items-center space-x-3 text-gray-700">
                                <i class="fas fa-phone text-green-500"></i>
                                <span>+1 (555) 123-4567</span>
                            </div>
                            <div class="flex items-center space-x-3 text-gray-700">
                                <i class="fas fa-clock text-purple-500"></i>
                                <span>Mon-Fri, 9:00 AM - 6:00 PM EST</span>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Action Buttons -->
                <div class="mt-8 flex flex-col sm:flex-row gap-4 justify-center">
                    <a href="/"
                       class="bg-gradient-to-r from-blue-600 to-indigo-600 text-white py-3 px-6 rounded-lg font-semibold hover:from-blue-700 hover:to-indigo-700 transform hover:-translate-y-0.5 transition-all duration-300 shadow-lg hover:shadow-xl inline-flex items-center justify-center gap-2">
                        <i class="fas fa-home"></i>
                        Back to Homepage
                    </a>
                    <a href="/Home/Terms"
                       class="border-2 border-gray-300 text-gray-700 py-3 px-6 rounded-lg font-semibold hover:border-blue-500 hover:text-blue-600 hover:bg-blue-50 transform hover:-translate-y-0.5 transition-all duration-300 inline-flex items-center justify-center gap-2">
                        <i class="fas fa-file-contract"></i>
                        View Terms of Service
                    </a>
                </div>
            </div>
        </div>

        <!-- Footer Note -->
        <div class="mt-8 text-center">
            <p class="text-sm text-gray-500">
                <i class="fas fa-info-circle mr-1"></i>
                This policy may be updated periodically. Please check back for the latest version.
            </p>
        </div>
    </div>

    <script>
        document.addEventListener('DOMContentLoaded', function() {
            // Add smooth scrolling for anchor links
            document.querySelectorAll('a[href^="#"]').forEach(anchor => {
                anchor.addEventListener('click', function (e) {
                    e.preventDefault();
                    const target = document.querySelector(this.getAttribute('href'));
                    if (target) {
                        target.scrollIntoView({
                            behavior: 'smooth',
                            block: 'start'
                        });
                    }
                });
            });

            // Add print functionality
            const printButton = document.createElement('button');
            printButton.innerHTML = '<i class="fas fa-print mr-2"></i>Print Policy';
            printButton.className = 'fixed bottom-4 right-4 bg-gray-700 text-white py-2 px-4 rounded-lg shadow-lg hover:bg-gray-800 transition-all duration-300 z-50';
            printButton.addEventListener('click', () => window.print());
            document.body.appendChild(printButton);
        });
    </script>
</body>
</html>