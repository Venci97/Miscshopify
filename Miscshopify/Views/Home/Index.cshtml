@using Miscshopify.Core.Models
@model IEnumerable<CategoryViewModel>
@{
    ViewData["Title"] = "Miscshopify - Your Modern Shopping Destination";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewData["Title"]</title>

    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&display=swap" rel="stylesheet">
    <link href="~/css/home.css" rel="stylesheet" />
</head>
<body class="home-page">
    <!-- Hero Section -->
    <section class="hero-section">
        <div class="hero-overlay">
            <div class="hero-content">
                <h1 class="hero-title">
                    Welcome to <span class="brand-gradient">Miscshopify</span>
                </h1>
                <p class="hero-subtitle">
                    Discover everything you need in one place. From cutting-edge electronics to trendy fashion and beyond.
                </p>
                <div class="hero-actions">
                    <a href="/Category/Index" class="btn-primary">
                        <i class="fas fa-shopping-bag mr-2"></i>
                        Start Shopping
                    </a>
                    <a href="#categories" class="btn-secondary">
                        <i class="fas fa-grid mr-2"></i>
                        Browse Categories
                    </a>
                </div>
            </div>
        </div>
    </section>

    <!-- Features Section -->
    <section class="features-section">
        <div class="container">
            <div class="features-grid">
                <div class="feature-card">
                    <div class="feature-icon">
                        <i class="fas fa-shipping-fast"></i>
                    </div>
                    <h3 class="feature-title">Free Shipping</h3>
                    <p class="feature-description">Free delivery on orders over $50</p>
                </div>
                <div class="feature-card">
                    <div class="feature-icon">
                        <i class="fas fa-shield-alt"></i>
                    </div>
                    <h3 class="feature-title">Secure Payment</h3>
                    <p class="feature-description">100% secure payment processing</p>
                </div>
                <div class="feature-card">
                    <div class="feature-icon">
                        <i class="fas fa-undo-alt"></i>
                    </div>
                    <h3 class="feature-title">Easy Returns</h3>
                    <p class="feature-description">30-day return policy</p>
                </div>
                <div class="feature-card">
                    <div class="feature-icon">
                        <i class="fas fa-headset"></i>
                    </div>
                    <h3 class="feature-title">24/7 Support</h3>
                    <p class="feature-description">Round-the-clock customer service</p>
                </div>
            </div>
        </div>
    </section>

    <!-- Categories Section -->
    <section id="categories" class="categories-section">
        <div class="container">
            <div class="section-header">
                <h2 class="section-title">Shop by Category</h2>
                <p class="section-subtitle">Explore our wide range of product categories</p>
            </div>

            <!-- Categories Container -->
            <div class="categories-container">
                <!-- Visible Categories (First Row) -->
                <div class="categories-visible">
                    <div class="categories-grid">
                        @{
                            var visibleCategories = Model.Take(4);
                            foreach (var category in visibleCategories)
                            {
                                <a href="@Url.Action("GetProductsByCategory", "Product", new { id = category.Id })" class="category-card">
                                    <div class="category-image-container">
                                        <img src="~/@category.ImagePath"
                                             alt="@category.Name"
                                             class="category-image"
                                             onerror="this.onerror=null; this.src='/images/category-placeholder.jpg'">
                                        <div class="category-overlay">
                                            <div class="overlay-content">
                                                <i class="fas fa-arrow-right"></i>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="category-content">
                                        <h3 class="category-name">@category.Name</h3>
                                        <p class="category-count">@(category.ProductsCount) Products</p>
                                    </div>
                                </a>
                            }
                        }
                    </div>
                </div>

                <!-- Hidden Categories (Expandable) -->
                @if (Model.Count() > 4)
                {
                    <div class="categories-hidden" id="hiddenCategories">
                        <div class="categories-grid">
                            @{
                                var hiddenCategories = Model.Skip(4);
                                foreach (var category in hiddenCategories)
                                {
                                    <a href="@Url.Action("GetProductsByCategory", "Product", new { id = category.Id })" class="category-card">
                                        <div class="category-image-container">
                                            <img src="~/@category.ImagePath"
                                                 alt="@category.Name"
                                                 class="category-image"
                                                 onerror="this.onerror=null; this.src='/images/category-placeholder.jpg'">
                                            <div class="category-overlay">
                                                <div class="overlay-content">
                                                    <i class="fas fa-arrow-right"></i>
                                                </div>
                                            </div>
                                        </div>
                                        <div class="category-content">
                                            <h3 class="category-name">@category.Name</h3>
                                            <p class="category-count">@(category.ProductsCount) Products</p>
                                        </div>
                                    </a>
                                }
                            }
                        </div>
                    </div>

                    <!-- Expand Button -->
                    <div class="expand-categories-container">
                        <button id="expandCategories" class="expand-categories-btn">
                            <span>Show All Categories</span>
                            <i class="fas fa-chevron-down expand-icon"></i>
                        </button>
                    </div>
                }
            </div>
        </div>
    </section>

    <!-- CTA Section -->
    <section class="cta-section">
        <div class="container">
            <div class="cta-content">
                <h2 class="cta-title">Ready to Start Shopping?</h2>
                <p class="cta-description">
                    Join thousands of satisfied customers who trust Miscshopify for their shopping needs.
                </p>
                <a href="/Category/Index" class="btn-primary btn-large">
                    <i class="fas fa-shopping-cart mr-2"></i>
                    Explore All Products
                </a>
            </div>
        </div>
    </section>

    <script>
        document.addEventListener('DOMContentLoaded', function() {
            const observerOptions = {
                threshold: 0.1,
                rootMargin: '0px 0px -50px 0px'
            };

            const observer = new IntersectionObserver((entries) => {
                entries.forEach(entry => {
                    if (entry.isIntersecting) {
                        entry.target.classList.add('animate-in');
                    }
                });
            }, observerOptions);

            // Observe all category cards and feature cards
            document.querySelectorAll('.category-card, .feature-card').forEach(card => {
                observer.observe(card);
            });

            // Expand categories functionality
            const expandButton = document.getElementById('expandCategories');
            const hiddenCategories = document.getElementById('hiddenCategories');
            const expandIcon = document.querySelector('.expand-icon');

            if (expandButton && hiddenCategories) {
                expandButton.addEventListener('click', function() {
                    if (hiddenCategories.classList.contains('expanded')) {
                        // Hide categories
                        hiddenCategories.classList.remove('expanded');
                        expandButton.querySelector('span').textContent = 'Show All Categories';
                        expandIcon.classList.remove('fa-chevron-up');
                        expandIcon.classList.add('fa-chevron-down');

                        // Smooth scroll back to categories section
                        document.getElementById('categories').scrollIntoView({
                            behavior: 'smooth',
                            block: 'start'
                        });
                    } else {
                        // Show hidden categories
                        hiddenCategories.classList.add('expanded');
                        expandButton.querySelector('span').textContent = 'Show Less';
                        expandIcon.classList.remove('fa-chevron-down');
                        expandIcon.classList.add('fa-chevron-up');

                        // Animate in hidden categories
                        const hiddenCards = hiddenCategories.querySelectorAll('.category-card');
                        hiddenCards.forEach((card, index) => {
                            card.style.animationDelay = `${index * 0.1}s`;
                            observer.observe(card);
                        });
                    }
                });
            }

            // Smooth scrolling for anchor links
            document.querySelectorAll('a[href^="#"]').forEach(anchor => {
                anchor.addEventListener('click', function (e) {
                    e.preventDefault();
                    const target = document.querySelector(this.getAttribute('href'));
                    if (target) {
                        target.scrollIntoView({
                            behavior: 'smooth',
                            block: 'start'
                        });
                    }
                });
            });
        });
    </script>
</body>
</html>