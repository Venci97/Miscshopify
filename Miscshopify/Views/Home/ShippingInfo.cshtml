@{
    ViewData["Title"] = "Shipping Information";
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Shipping Information - Modern Store</title>

    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <link href="~/css/shipping-info.css" rel="stylesheet" />
</head>
<body class="shipping-info-page">
    <div class="container">
        <!-- Header -->
        <div class="page-header">
            <div class="header-icon">
                <i class="fas fa-shipping-fast"></i>
            </div>
            <h1 class="header-title">Shipping Information</h1>
            <p class="header-subtitle">Fast, reliable delivery to your doorstep</p>
        </div>

        <!-- Shipping Options Summary -->
        <div class="shipping-summary">
            <div class="summary-card">
                <div class="summary-icon">
                    <i class="fas fa-truck"></i>
                </div>
                <h3>Standard Shipping</h3>
                <p class="price">Free</p>
                <p class="delivery-time">3-5 Business Days</p>
                <p class="minimum">Orders over 50 BGN</p>
            </div>

            <div class="summary-card featured">
                <div class="summary-icon">
                    <i class="fas fa-bolt"></i>
                </div>
                <h3>Express Shipping</h3>
                <p class="price">9.99 BGN</p>
                <p class="delivery-time">1-2 Business Days</p>
                <p class="minimum">All orders eligible</p>
            </div>

            <div class="summary-card">
                <div class="summary-icon">
                    <i class="fas fa-rocket"></i>
                </div>
                <h3>Overnight Shipping</h3>
                <p class="price">19.99 BGN</p>
                <p class="delivery-time">Next Business Day</p>
                <p class="minimum">Order by 2 PM</p>
            </div>
        </div>

        <!-- Main Content Grid -->
        <div class="content-grid">
            <!-- Shipping Methods -->
            <div class="shipping-methods">
                <h2 class="section-title">
                    <i class="fas fa-list-alt"></i>
                    Shipping Methods
                </h2>

                <div class="methods-list">
                    <div class="method-item">
                        <div class="method-header">
                            <div class="method-icon">
                                <i class="fas fa-truck"></i>
                            </div>
                            <div class="method-info">
                                <h3>Standard Shipping</h3>
                                <div class="method-badge free">Free</div>
                            </div>
                        </div>
                        <div class="method-details">
                            <p><strong>Delivery Time:</strong> 3-5 business days</p>
                            <p><strong>Cost:</strong> Free on orders over 50 BGN | 4.99 BGN under 50 BGN</p>
                            <p><strong>Tracking:</strong> Included</p>
                            <p><strong>Availability:</strong> Nationwide</p>
                        </div>
                    </div>

                    <div class="method-item">
                        <div class="method-header">
                            <div class="method-icon">
                                <i class="fas fa-bolt"></i>
                            </div>
                            <div class="method-info">
                                <h3>Express Shipping</h3>
                                <div class="method-badge express">Express</div>
                            </div>
                        </div>
                        <div class="method-details">
                            <p><strong>Delivery Time:</strong> 1-2 business days</p>
                            <p><strong>Cost:</strong> 9.99 BGN (flat rate)</p>
                            <p><strong>Tracking:</strong> Real-time tracking included</p>
                            <p><strong>Cut-off Time:</strong> Order by 5 PM for same-day dispatch</p>
                        </div>
                    </div>

                    <div class="method-item">
                        <div class="method-header">
                            <div class="method-icon">
                                <i class="fas fa-rocket"></i>
                            </div>
                            <div class="method-info">
                                <h3>Overnight Shipping</h3>
                                <div class="method-badge overnight">Overnight</div>
                            </div>
                        </div>
                        <div class="method-details">
                            <p><strong>Delivery Time:</strong> Next business day</p>
                            <p><strong>Cost:</strong> 19.99 BGN (flat rate)</p>
                            <p><strong>Tracking:</strong> Priority tracking with SMS updates</p>
                            <p><strong>Cut-off Time:</strong> Order by 2 PM for next-day delivery</p>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Delivery Information -->
            <div class="delivery-info">
                <h2 class="section-title">
                    <i class="fas fa-map-marked-alt"></i>
                    Delivery Information
                </h2>

                <div class="info-cards">
                    <div class="info-card">
                        <div class="info-icon">
                            <i class="fas fa-clock"></i>
                        </div>
                        <h3>Processing Time</h3>
                        <p>Orders are processed within <strong>24 hours</strong> during business days. Weekend orders are processed on Monday.</p>
                    </div>

                    <div class="info-card">
                        <div class="info-icon">
                            <i class="fas fa-home"></i>
                        </div>
                        <h3>Delivery Areas</h3>
                        <p>We deliver to all addresses in Bulgaria. Remote areas may have extended delivery times.</p>
                    </div>

                    <div class="info-card">
                        <div class="info-icon">
                            <i class="fas fa-box-open"></i>
                        </div>
                        <h3>Package Handling</h3>
                        <p>All packages are securely packed and insured. Signature may be required for delivery.</p>
                    </div>

                    <div class="info-card">
                        <div class="info-icon">
                            <i class="fas fa-calendar-check"></i>
                        </div>
                        <h3>Delivery Timeframes</h3>
                        <p>Business days are Monday-Friday. Deliveries are not made on weekends or national holidays.</p>
                    </div>
                </div>
            </div>
        </div>

        <!-- International Shipping -->
        <div class="international-shipping">
            <h2 class="section-title">
                <i class="fas fa-globe-europe"></i>
                International Shipping
            </h2>

            <div class="international-content">
                <div class="international-info">
                    <h3><i class="fas fa-shipping-fast"></i> Worldwide Delivery</h3>
                    <p>We ship to over 50 countries worldwide. International shipping costs and delivery times vary by destination.</p>

                    <div class="shipping-zones">
                        <div class="zone-card">
                            <h4><i class="fas fa-flag-eu"></i> European Union</h4>
                            <p><strong>Delivery:</strong> 5-7 business days</p>
                            <p><strong>Cost:</strong> From 14.99 BGN</p>
                        </div>

                        <div class="zone-card">
                            <h4><i class="fas fa-globe-americas"></i> North America</h4>
                            <p><strong>Delivery:</strong> 7-10 business days</p>
                            <p><strong>Cost:</strong> From 19.99 BGN</p>
                        </div>

                        <div class="zone-card">
                            <h4><i class="fas fa-globe-asia"></i> Asia & Australia</h4>
                            <p><strong>Delivery:</strong> 10-14 business days</p>
                            <p><strong>Cost:</strong> From 24.99 BGN</p>
                        </div>
                    </div>
                </div>

                <div class="customs-info">
                    <div class="customs-notice">
                        <i class="fas fa-info-circle"></i>
                        <div>
                            <h4>Customs & Import Taxes</h4>
                            <p>International customers are responsible for any customs duties, taxes, or fees imposed by their country. These charges are not included in the shipping cost.</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Tracking & Support -->
        <div class="tracking-support">
            <h2 class="section-title">
                <i class="fas fa-map-marker-alt"></i>
                Order Tracking & Support
            </h2>

            <div class="tracking-content">
                <div class="tracking-steps">
                    <div class="tracking-step">
                        <div class="step-number">1</div>
                        <div class="step-content">
                            <h3>Order Confirmation</h3>
                            <p>You'll receive an email confirmation immediately after placing your order.</p>
                        </div>
                    </div>

                    <div class="tracking-step">
                        <div class="step-number">2</div>
                        <div class="step-content">
                            <h3>Shipping Notification</h3>
                            <p>Once your order ships, we'll send you a tracking number and link.</p>
                        </div>
                    </div>

                    <div class="tracking-step">
                        <div class="step-number">3</div>
                        <div class="step-content">
                            <h3>Real-time Tracking</h3>
                            <p>Use your tracking number to monitor your package's journey in real-time.</p>
                        </div>
                    </div>

                    <div class="tracking-step">
                        <div class="step-number">4</div>
                        <div class="step-content">
                            <h3>Delivery Confirmation</h3>
                            <p>You'll receive a final notification when your package is delivered.</p>
                        </div>
                    </div>
                </div>

                <div class="support-options">
                    <h3>Need Help With Shipping?</h3>
                    <div class="support-cards">
                        <div class="support-card">
                            <i class="fas fa-question-circle"></i>
                            <h4>Track Your Order</h4>
                            <p>Can't find your tracking information? Contact us for assistance.</p>
                            <a href="/Home/Contact" class="support-link">Get Help</a>
                        </div>

                        <div class="support-card">
                            <i class="fas fa-exclamation-triangle"></i>
                            <h4>Delivery Issues</h4>
                            <p>Experiencing delays or problems with delivery? We're here to help.</p>
                            <a href="/Home/Contact" class="support-link">Report Issue</a>
                        </div>

                        <div class="support-card">
                            <i class="fas fa-edit"></i>
                            <h4>Change Delivery Address</h4>
                            <p>Need to change your delivery address? Contact us as soon as possible.</p>
                            <a href="/Home/Contact" class="support-link">Update Address</a>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- FAQ Section -->
        <div class="faq-section">
            <h2 class="section-title">
                <i class="fas fa-question-circle"></i>
                Shipping FAQs
            </h2>

            <div class="faq-grid">
                <div class="faq-item">
                    <h3><i class="fas fa-question"></i> How can I get free shipping?</h3>
                    <p>Free standard shipping is automatically applied to all orders over 50 BGN. Simply add items to your cart until you reach the minimum amount.</p>
                </div>

                <div class="faq-item">
                    <h3><i class="fas fa-question"></i> Can I change my shipping address after ordering?</h3>
                    <p>Yes, if your order hasn't shipped yet. Contact our customer service immediately to update your shipping address.</p>
                </div>

                <div class="faq-item">
                    <h3><i class="fas fa-question"></i> Do you ship on weekends?</h3>
                    <p>We process and ship orders Monday through Friday. Deliveries typically occur on business days only.</p>
                </div>

                <div class="faq-item">
                    <h3><i class="fas fa-question"></i> What if I'm not home for delivery?</h3>
                    <p>The courier will attempt delivery 3 times. After that, your package will be held at a local pickup point for 7 days.</p>
                </div>

                <div class="faq-item">
                    <h3><i class="fas fa-question"></i> Can I upgrade my shipping after ordering?</h3>
                    <p>If your order hasn't been processed, contact us immediately. We may be able to upgrade your shipping method.</p>
                </div>

                <div class="faq-item">
                    <h3><i class="fas fa-question"></i> Are there any shipping restrictions?</h3>
                    <p>Some items may have shipping restrictions due to size, weight, or legal regulations. These will be noted on the product page.</p>
                </div>
            </div>
        </div>

        <!-- Action Buttons -->
        <div class="action-buttons">
            <a href="/Home/Contact" class="action-btn primary">
                <i class="fas fa-headset"></i>
                Contact Shipping Support
            </a>
            <a href="/" class="action-btn secondary">
                <i class="fas fa-home"></i>
                Back to Home
            </a>
            <a href="/Home/ReturnsRefunds" class="action-btn outline">
                <i class="fas fa-undo-alt"></i>
                Returns & Refunds
            </a>
        </div>
    </div>

    <script>
        document.addEventListener('DOMContentLoaded', function() {
            // Add interactivity to shipping method cards
            const methodItems = document.querySelectorAll('.method-item');
            methodItems.forEach(item => {
                item.addEventListener('click', function() {
                    // Remove active class from all items
                    methodItems.forEach(i => i.classList.remove('active'));
                    // Add active class to clicked item
                    this.classList.add('active');
                });
            });

            // Add hover effects to summary cards
            const summaryCards = document.querySelectorAll('.summary-card');
            summaryCards.forEach(card => {
                card.addEventListener('mouseenter', function() {
                    this.style.transform = 'translateY(-10px) scale(1.02)';
                });
                card.addEventListener('mouseleave', function() {
                    this.style.transform = 'translateY(0) scale(1)';
                });
            });

            // Expandable FAQ items
            const faqItems = document.querySelectorAll('.faq-item');
            faqItems.forEach(item => {
                const question = item.querySelector('h3');
                const answer = item.querySelector('p');

                // Initially hide answers
                answer.style.display = 'none';

                question.style.cursor = 'pointer';
                question.addEventListener('click', function() {
                    const isVisible = answer.style.display === 'block';
                    answer.style.display = isVisible ? 'none' : 'block';

                    // Rotate icon
                    const icon = this.querySelector('i');
                    icon.style.transform = isVisible ? 'rotate(0deg)' : 'rotate(45deg)';
                    icon.style.transition = 'transform 0.3s ease';
                });
            });

            // Smooth scrolling for internal links
            document.querySelectorAll('a[href^="#"]').forEach(anchor => {
                anchor.addEventListener('click', function (e) {
                    e.preventDefault();
                    const target = document.querySelector(this.getAttribute('href'));
                    if (target) {
                        target.scrollIntoView({
                            behavior: 'smooth',
                            block: 'start'
                        });
                    }
                });
            });
        });
    </script>
</body>
</html>